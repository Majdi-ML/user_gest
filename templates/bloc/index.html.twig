{% extends 'base.html.twig' %}

{% block title %}Liste des Blocs{% endblock %}

{% block css %}
    {{ parent() }}
    {% include '_modern_index_styles.html.twig' %}
    <style>
        .action-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
        }
        .action-bar > div {
            display: flex;
            gap: 0.5rem;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container-fluid mt-4 px-4 fade-in">
    <div class="page-header">
        <h1>
            <span class="page-header-icon">🏢</span>
            Liste des Blocs
        </h1>
        <p class="mb-0 mt-2" style="opacity: 0.9;">Gestion des blocs d'immeubles</p>
    </div>

    <div class="action-bar">
        <div>
            <button id="exportPdfBtn" class="btn btn-danger">
                <i class="bi bi-file-pdf"></i> Exporter en PDF
            </button>
            <button id="exportExcelBtn" class="btn btn-success">
                <i class="bi bi-file-excel"></i> Exporter en Excel
            </button>
        </div>
        <a href="{{ path('app_bloc_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-circle-fill"></i> Nouveau Bloc
        </a>
    </div>

    <div class="table-card">
        <div class="table-responsive">
            <table class="table table-modern">
                <thead>
                    <tr>
                        <th><i class="bi bi-hash"></i> ID</th>
                        <th><i class="bi bi-building"></i> Nom</th>
                        <th><i class="bi bi-layers-fill"></i> Étages</th>
                        <th><i class="bi bi-door-closed-fill"></i> Apparts/Étage</th>
                        <th><i class="bi bi-grid-3x3-gap-fill"></i> Total Appartements</th>
                        <th><i class="bi bi-gear-fill"></i> Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for bloc in blocs %}
                    <tr>
                        <td><span class="badge-modern bg-light">{{ bloc.id }}</span></td>
                        <td><strong>{{ bloc.nom }}</strong></td>
                        <td>{{ bloc.nombreEtages }}</td>
                        <td>{{ bloc.nombreAppartementEtage }}</td>
                        <td><span class="badge-modern bg-primary">{{ bloc.nombreTotaleAppartement }}</span></td>
                        <td>
                            <div class="action-buttons">
                                <a href="{{ path('app_bloc_show', {'id': bloc.id}) }}" class="btn btn-sm btn-info" title="Voir">
                                    <i class="bi bi-eye-fill"></i>
                                </a>
                                <a href="{{ path('app_bloc_edit', {'id': bloc.id}) }}" class="btn btn-sm btn-warning" title="Modifier">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            <i class="bi bi-inbox" style="font-size: 2rem;"></i>
                            <p class="mb-0 mt-2">Aucun bloc trouvé</p>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}

{% block js %}
    {{ parent() }}
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script>
        $(document).ready(function() {
            function collectVisibleData() {
                const headers = ['ID', 'Nom', 'Étages', 'Apparts/Étage', 'Total Appartements'];
                const data = [];
                
                $('.table tbody tr').each(function() {
                    const id = $(this).find('td:eq(0) .badge-modern').text().trim();
                    if (id) { // Skip empty row
                        const nom = $(this).find('td:eq(1) strong').text().trim();
                        const etages = $(this).find('td:eq(2)').text().trim();
                        const appartsEtage = $(this).find('td:eq(3)').text().trim();
                        const totalApparts = $(this).find('td:eq(4) .badge-modern').text().trim();
                        
                        data.push({
                            'ID': id,
                            'Nom': nom,
                            'Étages': etages,
                            'Apparts/Étage': appartsEtage,
                            'Total Appartements': totalApparts
                        });
                    }
                });
                
                return { headers, data };
            }
            
            $('#exportPdfBtn').click(function() {
                const { jsPDF } = window.jspdf;
                const doc = new jsPDF();
                const { headers, data } = collectVisibleData();
                
                doc.setFontSize(14);
                doc.text('Liste des Blocs', 14, 15);
                doc.autoTable({
                    head: [headers],
                    body: data.map(row => headers.map(h => row[h] || '')),
                    startY: 25,
                    styles: { fontSize: 10, cellPadding: 3 }
                });
                doc.save('blocs.pdf');
            });
            
            $('#exportExcelBtn').click(function() {
                const { headers, data } = collectVisibleData();
                const ws = XLSX.utils.json_to_sheet(data, { header: headers });
                const wb = XLSX.utils.book_new();
                XLSX.utils.book_append_sheet(wb, ws, 'Blocs');
                XLSX.writeFile(wb, 'blocs.xlsx');
            });
        });
    </script>
{% endblock %}
