{% extends 'base.html.twig' %}

{% block title %}Détails du Bloc{% endblock %}

{% block css %}
    {{ parent() }}
    {% include '_modern_show_styles.html.twig' %}
{% endblock %}

{% block body %}
<div class="container-fluid mt-4 px-4 fade-in">
    <div class="page-header">
        <h1>
            <span class="page-header-icon">🏢</span>
            Détails du Bloc
        </h1>
        <p class="mb-0 mt-2" style="opacity: 0.9;">Informations complètes du bloc et ses appartements</p>
    </div>

    <div class="detail-card">
        <div class="card-header">
            <i class="bi bi-building-fill"></i> Informations du Bloc
        </div>
        <div class="card-body">
            <div class="info-grid">
                <div class="info-item">
                    <label><i class="bi bi-hash"></i> ID</label>
                    <div class="info-value">{{ bloc.id }}</div>
                </div>
                <div class="info-item">
                    <label><i class="bi bi-building"></i> Nom</label>
                    <div class="info-value"><strong>{{ bloc.nom }}</strong></div>
                </div>
                <div class="info-item">
                    <label><i class="bi bi-layers-fill"></i> Nombre d'étages</label>
                    <div class="info-value">{{ bloc.nombreEtages }}</div>
                </div>
                <div class="info-item">
                    <label><i class="bi bi-door-closed-fill"></i> Appartements par étage</label>
                    <div class="info-value">{{ bloc.nombreAppartementEtage }}</div>
                </div>
                <div class="info-item">
                    <label><i class="bi bi-grid-3x3-gap-fill"></i> Total appartements</label>
                    <div class="info-value"><span class="badge-modern bg-primary">{{ bloc.nombreTotaleAppartement }}</span></div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 mb-3">
        <button id="exportPdfBtn" class="btn btn-danger btn-sm">
            <i class="bi bi-file-earmark-pdf-fill"></i> Exporter PDF
        </button>
        <button id="exportExcelBtn" class="btn btn-success btn-sm">
            <i class="bi bi-file-earmark-excel-fill"></i> Exporter Excel
        </button>
    </div>

    <div class="detail-card">
        <div class="card-header">
            <i class="bi bi-house-door-fill"></i> Appartements (Triés par étage)
        </div>
        <div class="card-body">
            {% set appartementsTries = bloc.appartements|sort((a, b) => a.etage <=> b.etage) %}

            {% if appartementsTries is not empty %}
                <div class="table-wrapper">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th><i class="bi bi-layers"></i> Étage</th>
                                <th><i class="bi bi-123"></i> Numéro</th>
                                <th><i class="bi bi-house-fill"></i> Type</th>
                                <th><i class="bi bi-check-circle"></i> Occupé</th>
                                <th><i class="bi bi-person"></i> Locataire</th>
                                <th><i class="bi bi-person-badge"></i> Propriétaire</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for appartement in appartementsTries %}
                            <tr>
                                <td><span class="badge-modern bg-secondary">{{ appartement.etage }}</span></td>
                                <td><strong>{{ appartement.numero }}</strong></td>
                                <td>{{ appartement.type }}</td>
                                <td>
                                    {% if appartement.estHabite %}
                                        <span class="badge-modern bg-success"><i class="bi bi-check-circle-fill"></i> Oui</span>
                                    {% else %}
                                        <span class="badge-modern bg-danger"><i class="bi bi-x-circle-fill"></i> Non</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if appartement.locataire %}
                                        {{ appartement.locataire.nom }} {{ appartement.locataire.prenom }}
                                    {% else %}
                                        <span class="text-muted">—</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if appartement.proprietaire %}
                                        {{ appartement.proprietaire.nom }} {{ appartement.proprietaire.prenom }}
                                    {% else %}
                                        <span class="text-muted">—</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle-fill"></i> Aucun appartement associé à ce bloc.
                </div>
            {% endif %}
        </div>
    </div>

    <div class="action-buttons">
        <a href="{{ path('app_bloc_index') }}" class="btn btn-secondary">
            <i class="bi bi-arrow-left-circle-fill"></i> Retour à la liste
        </a>
        <a href="{{ path('app_bloc_edit', {'id': bloc.id}) }}" class="btn btn-warning">
            <i class="bi bi-pencil-fill"></i> Modifier
        </a>
        {{ include('bloc/_delete_form.html.twig') }}
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const blocNom = '{{ bloc.nom }}';

        function collectData() {
            const headers = ['Étage', 'Numéro', 'Type', 'Occupé', 'Locataire', 'Propriétaire'];
            const data = [];
            const rows = document.querySelectorAll('.table-wrapper table tbody tr');

            rows.forEach(function(row) {
                const cells = row.querySelectorAll('td');
                if (cells.length >= 6) {
                    data.push({
                        'Étage': cells[0].textContent.trim(),
                        'Numéro': cells[1].textContent.trim(),
                        'Type': cells[2].textContent.trim(),
                        'Occupé': cells[3].textContent.trim(),
                        'Locataire': cells[4].textContent.trim(),
                        'Propriétaire': cells[5].textContent.trim()
                    });
                }
            });

            return { headers, data };
        }

        document.getElementById('exportPdfBtn').addEventListener('click', function() {
            const { jsPDF } = window.jspdf;
            const doc = new jsPDF({ orientation: 'landscape' });
            const { headers, data } = collectData();

            doc.setFontSize(16);
            doc.text('Details du Bloc - ' + blocNom, 14, 15);

            doc.setFontSize(10);
            doc.text('Etages: {{ bloc.nombreEtages }} | Apparts/etage: {{ bloc.nombreAppartementEtage }} | Total: {{ bloc.nombreTotaleAppartement }}', 14, 23);

            doc.autoTable({
                head: [headers],
                body: data.map(function(row) { return headers.map(function(h) { return row[h]; }); }),
                startY: 28,
                theme: 'striped',
                headStyles: { fillColor: [102, 126, 234] },
                styles: { fontSize: 9 }
            });

            doc.save('bloc_' + blocNom + '.pdf');
        });

        document.getElementById('exportExcelBtn').addEventListener('click', function() {
            const { headers, data } = collectData();

            const ws = XLSX.utils.json_to_sheet(data, { header: headers });
            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, 'Bloc ' + blocNom);
            XLSX.writeFile(wb, 'bloc_' + blocNom + '.xlsx');
        });
    });
</script>
{% endblock %}
