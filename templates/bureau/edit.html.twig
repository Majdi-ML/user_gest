{% extends 'base.html.twig' %}

{% block title %}Modifier Membre{% endblock %}

{% block css %}
    {{ parent() }}
    {% include '_modern_form_styles.html.twig' %}
{% endblock %}

{% block body %}
<div class="container-fluid mt-4 px-4 fade-in">
    <div class="page-header">
        <h1>
            <span class="page-header-icon">✏️</span>
            Modifier {{ bureau.nom }} {{ bureau.prenom }}
        </h1>
        <p class="mb-0 mt-2" style="opacity: 0.9;">Modifiez les informations du membre du bureau</p>
    </div>

    <div class="form-card">
        <div class="card-header">
            <i class="bi bi-pencil-square"></i> Formulaire de modification
        </div>
        <div class="card-body">
            {{ include('bureau/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
        </div>
    </div>

    <div class="action-buttons">
        <a href="{{ path('app_bureau_index') }}" class="btn btn-secondary">
            <i class="bi bi-arrow-left-circle-fill"></i> Retour à la liste
        </a>
        {{ include('bureau/_delete_form.html.twig') }}
    </div>
</div>
{% endblock %}
