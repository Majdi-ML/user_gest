{% extends 'base.html.twig' %}

{% block title %}Détails du Membre du Bureau{% endblock %}

{% block css %}
    {{ parent() }}
    {% include '_modern_show_styles.html.twig' %}
{% endblock %}

{% block body %}
<div class="container-fluid mt-4 px-4 fade-in">
    <div class="page-header">
        <h1>
            <span class="page-header-icon">👥</span>
            {{ bureau.nom }} {{ bureau.prenom }}
        </h1>
        <p class="mb-0 mt-2" style="opacity: 0.9;">Informations détaillées du membre du bureau</p>
    </div>

    <div class="detail-card">
        <div class="card-header">
            <i class="bi bi-person-lines-fill"></i> Informations du membre
        </div>
        <div class="card-body">
            <table class="table table-detail">
                <tbody>
                    <tr>
                        <th><i class="bi bi-hash"></i> ID</th>
                        <td>{{ bureau.id }}</td>
                    </tr>
                    <tr>
                        <th><i class="bi bi-person-fill"></i> Nom</th>
                        <td>{{ bureau.nom }}</td>
                    </tr>
                    <tr>
                        <th><i class="bi bi-person-badge-fill"></i> Prénom</th>
                        <td>{{ bureau.prenom }}</td>
                    </tr>
                    <tr>
                        <th><i class="bi bi-telephone-fill"></i> Téléphone</th>
                        <td>{{ bureau.telephone }}</td>
                    </tr>
                    <tr>
                        <th><i class="bi bi-tag-fill"></i> Statut</th>
                        <td>
                            <span class="badge badge-modern bg-primary">
                                {{ bureau.status ? bureau.status.libelle : '—' }}
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <th><i class="bi bi-briefcase-fill"></i> Fonction</th>
                        <td>
                            <span class="badge badge-modern bg-info">
                                {{ bureau.fonction ? bureau.fonction.libelle : '—' }}
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <th><i class="bi bi-calendar-check-fill"></i> Année Début de Mandat</th>
                        <td><strong>{{ bureau.anneeDebut }}</strong></td>
                    </tr>
                    <tr>
                        <th><i class="bi bi-calendar-x-fill"></i> Année Fin de Mandat</th>
                        <td><strong>{{ bureau.anneeFin }}</strong></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="action-buttons">
        <a href="{{ path('app_bureau_index') }}" class="btn btn-secondary">
            <i class="bi bi-arrow-left-circle-fill"></i> Retour à la liste
        </a>
        <a href="{{ path('app_bureau_edit', {'id': bureau.id}) }}" class="btn btn-warning">
            <i class="bi bi-pencil-fill"></i> Modifier
        </a>
        {{ include('bureau/_delete_form.html.twig') }}
    </div>
</div>
{% endblock %}