{% extends 'base.html.twig' %}

{% block title %}Frais Syndic{% endblock %}

{% block css %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-multiselect@1.1.2/dist/css/bootstrap-multiselect.min.css" rel="stylesheet">
    <style>
        .form-container {
            max-width: 800px; /* Limit form width */
            margin: 0 auto;
        }
        .form-row {
            margin-bottom: 1rem; /* Space between rows */
        }
        .form-select {
            font-size: 0.9rem; /* Smaller font size */
        }
        .multiselect-container {
            max-height: 200px; /* Scrollable dropdown */
            overflow-y: auto;
        }
        .btn-primary, .btn-secondary {
            font-size: 0.9rem;
            padding: 0.5rem 1rem;
        }
        .alert {
            max-width: 800px;
            margin: 0 auto 1rem;
        }
    </style>
{% endblock %}

{% block body %}
<div class="form-container">
    <h1 class="mb-4">💰 Frais Syndic</h1>

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    {{ form_start(form, {'attr': {'class': 'row g-3'}}) }}
        <div class="col-md-6 form-row">
            {{ form_label(form.Montant) }}
            {{ form_widget(form.Montant, {'attr': {'class': 'form-select'}}) }}
            {{ form_errors(form.Montant) }}
        </div>
        <div class="col-md-6 form-row">
            {{ form_label(form.annee) }}
            {{ form_widget(form.annee, {'attr': {'class': 'form-select'}}) }}
            {{ form_errors(form.annee) }}
        </div>
        <div class="col-md-6 form-row">
            {{ form_label(form.Mois) }}
            {{ form_widget(form.Mois, {'attr': {'class': 'form-select multiselect'}}) }}
            {{ form_errors(form.Mois) }}
        </div>
        <div class="col-md-6 form-row">
            {{ form_label(form.appartement) }}
            {{ form_widget(form.appartement, {'attr': {'class': 'form-select multiselect appartement-select'}}) }}
            {{ form_errors(form.appartement) }}
        </div>
        <div class="col-md-6 form-row">
            {{ form_label(form.Nature_Paiement) }}
            {{ form_widget(form.Nature_Paiement, {'attr': {'class': 'form-select'}}) }}
            {{ form_errors(form.Nature_Paiement) }}
        </div>
        <div class="col-12 form-row">
            <button type="submit" class="btn btn-primary">Enregistrer</button>
            <a href="{{ path('app_cautionnement_index') }}" class="btn btn-secondary ms-2">Retour à la liste</a>
        </div>
    {{ form_end(form) }}
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap-multiselect@1.1.2/dist/js/bootstrap-multiselect.min.js"></script>
<script>
    $(document).ready(function () {
        // Initialize Bootstrap Multiselect for Mois and appartement
        $('.multiselect').multiselect({
            enableFiltering: true, // Enable search within options
            includeSelectAllOption: true, // Add "Select All" option
            maxHeight: 200, // Match CSS max-height
            buttonClass: 'btn btn-outline-secondary', // Bootstrap button style
            templates: {
                filter: '<li class="multiselect-item filter"><div class="input-group"><input class="form-control multiselect-search" type="text"></div></li>',
                li: '<li><a class="multiselect-option"><label></label></a></li>'
            }
        });

        // Initially disable the personne field (if it exists)
        $('.personne-select').prop('disabled', true);

        // When appartement selection changes
        $('.appartement-select').on('change', function () {
            const selectedAppartements = $(this).val() || [];
            const personneSelect = $('.personne-select');

            // Clear and disable the personne field
            personneSelect.empty().prop('disabled', true);
            personneSelect.append('<option>Sélectionnez un appartement d\'abord</option>');

            if (selectedAppartements.length > 0) {
                // Fetch owners for selected apartments
                $.ajax({
                    url: '/cautionnement/get-personnes/' + selectedAppartements.join(','),
                    method: 'GET',
                    success: function (data) {
                        personneSelect.empty();
                        if (data.length > 0) {
                            personneSelect.prop('disabled', false);
                            data.forEach(function (personne) {
                                personneSelect.append(
                                    `<option value="${personne.id}" selected>${personne.text}</option>`
                                );
                            });
                        } else {
                            personneSelect.append('<option>Aucun propriétaire trouvé</option>');
                        }
                    },
                    error: function () {
                        personneSelect.append('<option>Erreur lors du chargement</option>');
                    }
                });
            }
        });
    });
</script>
{% endblock %}