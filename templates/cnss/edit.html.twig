{% extends 'base.html.twig' %}

{% block title %}Modifier Déclaration CNSS{% endblock %}

{% block css %}
    {{ parent() }}
    {% include '_modern_form_styles.html.twig' %}
{% endblock %}

{% block body %}
<div class="container-fluid p-4">
    <div class="page-header">
        <div class="page-header-content">
            <div>
                <h1><i class="bi bi-pencil-square"></i> Modifier Déclaration</h1>
                <p class="page-subtitle">Mise à jour de la déclaration #{{ cnss.id }}</p>
            </div>
        </div>
    </div>

    <div class="form-card">
        {{ include('cnss/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
    </div>

    <div class="action-buttons mt-3">
        <a href="{{ path('app_cnss_index') }}" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
        {{ include('cnss/_delete_form.html.twig') }}
    </div>
</div>
{% endblock %}
