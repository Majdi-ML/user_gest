{% extends 'base.html.twig' %}

{% block title %}Nouveau Congé{% endblock %}

{% block css %}
    {{ parent() }}
    {% include '_modern_form_styles.html.twig' %}
{% endblock %}

{% block body %}
<div class="container-fluid p-4">
    <div class="page-header">
        <div class="page-header-content">
            <div>
                <h1><i class="bi bi-plus-circle"></i> Nouveau Congé</h1>
                <p class="page-subtitle">Enregistrer un nouveau congé</p>
            </div>
        </div>
    </div>

    <div class="form-card">
        {{ include('conge/_form.html.twig') }}
    </div>

    <div class="action-buttons mt-3">
        <a href="{{ path('app_conge_index') }}" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
    </div>
</div>
{% endblock %}
