{% extends 'base.html.twig' %}

{% block title %}Détails du Congé{% endblock %}

{% block css %}
    {{ parent() }}
    {% include '_modern_show_styles.html.twig' %}
    <style>
        .preview-image {
            max-width: 200px;
            max-height: 200px;
            object-fit: contain;
            margin-top: 10px;
        }
        .pdf-embed {
            width: 100%;
            height: 400px;
            border: 1px solid #e5e7eb;
            margin-top: 10px;
            border-radius: 8px;
        }
        .file-download {
            margin-top: 10px;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container-fluid p-4">
    <div class="page-header">
        <div class="page-header-content">
            <div>
                <h1><i class="bi bi-calendar-x"></i> Détails Congé #{{ conge.id }}</h1>
                <p class="page-subtitle">Informations du congé</p>
            </div>
        </div>
    </div>

    <div class="detail-card">
        <h2 class="section-title"><i class="bi bi-info-circle"></i> Informations</h2>
        <div class="info-grid">
            <div class="info-item">
                <label>ID</label>
                <div class="info-value">{{ conge.id }}</div>
            </div>
            <div class="info-item">
                <label>Employé</label>
                <div class="info-value">{{ conge.employe ? conge.employe.nom ~ ' ' ~ conge.employe.prenom : '—' }}</div>
            </div>
            <div class="info-item">
                <label>Date de début</label>
                <div class="info-value">{{ conge.dateDebut ? conge.dateDebut|date('d/m/Y') : '—' }}</div>
            </div>
            <div class="info-item">
                <label>Date de fin</label>
                <div class="info-value">{{ conge.dateFin ? conge.dateFin|date('d/m/Y') : '—' }}</div>
            </div>
            <div class="info-item full-width">
                <label>Motif</label>
                <div class="info-value">{{ conge.motif|default('—') }}</div>
            </div>
            <div class="info-item full-width">
                <label>Document attaché</label>
                <div class="info-value">
                    {% if conge.attachedFile %}
                        {% set fileExtension = conge.attachedFile|lower|split('.')|last %}
                        {% set fileUrl = vich_uploader_asset(conge, 'congeFile') %}
                        {% if fileExtension in ['jpg', 'jpeg', 'png', 'gif'] %}
                            <a href="{{ fileUrl }}" target="_blank">
                                <img src="{{ fileUrl }}" alt="Document attaché" class="preview-image img-fluid">
                            </a>
                            <div class="file-download">
                                <a href="{{ fileUrl }}" class="btn btn-sm btn-success" download>
                                    <i class="bi bi-download"></i> Télécharger l'image
                                </a>
                            </div>
                        {% elseif fileExtension == 'pdf' %}
                            <div class="file-download">
                                <a href="{{ fileUrl }}" class="btn btn-sm btn-danger" target="_blank">
                                    <i class="bi bi-file-pdf"></i> Voir le PDF
                                </a>
                                <a href="{{ fileUrl }}" class="btn btn-sm btn-success" download>
                                    <i class="bi bi-download"></i> Télécharger le PDF
                                </a>
                            </div>
                            {# Optional: Embed PDF if supported by the browser #}
                            <embed src="{{ fileUrl }}" class="pdf-embed" type="application/pdf">
                        {% elseif fileExtension in ['doc', 'docx'] %}
                            <div class="file-download">
                                <a href="{{ fileUrl }}" class="btn btn-sm btn-primary" download>
                                    <i class="bi bi-file-word"></i> Télécharger le document
                                </a>
                            </div>
                        {% else %}
                            <div class="file-download">
                                <a href="{{ fileUrl }}" class="btn btn-sm btn-secondary" download>
                                    <i class="bi bi-download"></i> Télécharger le fichier
                                </a>
                            </div>
                        {% endif %}
                    {% else %}
                        <span class="badge bg-secondary">Aucun document</span>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="action-buttons">
        <a href="{{ path('app_conge_index') }}" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
        <a href="{{ path('app_conge_edit', {'id': conge.id}) }}" class="btn btn-warning">
            <i class="bi bi-pencil-fill"></i> Modifier
        </a>
        {{ include('conge/_delete_form.html.twig') }}
    </div>
</div>
{% endblock %}