{% extends 'base.html.twig' %}

{% block title %}Détails du Congé{% endblock %}

{% block css %}
    {{ parent() }}
    <style>
        .card-header {
            background-color: #f8f9fa;
            font-weight: bold;
        }
        .preview-image {
            max-width: 200px;
            max-height: 200px;
            object-fit: contain;
            margin-top: 10px;
        }
        .pdf-embed {
            width: 100%;
            height: 400px;
            border: 1px solid #dee2e6;
            margin-top: 10px;
        }
        .file-download {
            margin-top: 10px;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1 class="mb-4">📅 Détails du Congé</h1>

    <div class="card shadow-sm mb-5">
        <div class="card-header">
            Informations du Congé #{{ conge.id }}
        </div>
        <div class="card-body">
            <table class="table table-striped mb-0">
                <tbody>
                    <tr>
                        <th scope="row">ID</th>
                        <td>{{ conge.id }}</td>
                    </tr>
                    <tr>
                        <th scope="row">Employé</th>
                        <td>{{ conge.employe ? conge.employe.nom ~ ' ' ~ conge.employe.nom : '—' }}</td>
                    </tr>
                    <tr>
                        <th scope="row">Date de début</th>
                        <td>{{ conge.dateDebut ? conge.dateDebut|date('d/m/Y') : '—' }}</td>
                    </tr>
                    <tr>
                        <th scope="row">Date de fin</th>
                        <td>{{ conge.dateFin ? conge.dateFin|date('d/m/Y') : '—' }}</td>
                    </tr>
                    <tr>
                        <th scope="row">Motif</th>
                        <td>{{ conge.motif|default('—') }}</td>
                    </tr>
                    <tr>
                        <th scope="row">Document attaché</th>
                        <td>
                            {% if conge.attachedFile %}
                                {% set fileExtension = conge.attachedFile|lower|split('.')|last %}
                                {% set fileUrl = vich_uploader_asset(conge, 'congeFile') %}
                                {% if fileExtension in ['jpg', 'jpeg', 'png', 'gif'] %}
                                    <a href="{{ fileUrl }}" target="_blank">
                                        <img src="{{ fileUrl }}" alt="Document attaché" class="preview-image img-fluid">
                                    </a>
                                    <div class="file-download">
                                        <a href="{{ fileUrl }}" class="btn btn-sm btn-success" download>
                                            <i class="bi bi-download"></i> Télécharger l'image
                                        </a>
                                    </div>
                                {% elseif fileExtension == 'pdf' %}
                                    <div class="file-download">
                                        <a href="{{ fileUrl }}" class="btn btn-sm btn-danger" target="_blank">
                                            <i class="bi bi-file-pdf"></i> Voir le PDF
                                        </a>
                                        <a href="{{ fileUrl }}" class="btn btn-sm btn-success" download>
                                            <i class="bi bi-download"></i> Télécharger le PDF
                                        </a>
                                    </div>
                                    {# Optional: Embed PDF if supported by the browser #}
                                    <embed src="{{ fileUrl }}" class="pdf-embed" type="application/pdf">
                                {% elseif fileExtension in ['doc', 'docx'] %}
                                    <div class="file-download">
                                        <a href="{{ fileUrl }}" class="btn btn-sm btn-primary" download>
                                            <i class="bi bi-file-word"></i> Télécharger le document
                                        </a>
                                    </div>
                                {% else %}
                                    <div class="file-download">
                                        <a href="{{ fileUrl }}" class="btn btn-sm btn-secondary" download>
                                            <i class="bi bi-download"></i> Télécharger le fichier
                                        </a>
                                    </div>
                                {% endif %}
                            {% else %}
                                <span class="badge bg-secondary">Aucun document</span>
                            {% endif %}
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="d-flex gap-2 mb-4">
        <a href="{{ path('app_conge_index') }}" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Retour à la liste
        </a>
        <a href="{{ path('app_conge_edit', {'id': conge.id}) }}" class="btn btn-primary">
            <i class="bi bi-pencil"></i> Modifier
        </a>
        {{ include('conge/_delete_form.html.twig') }}
    </div>
</div>
{% endblock %}