{% extends 'base.html.twig' %}

{% block title %}Modifier la Caisse{% endblock %}

{% block css %}
    {{ parent() }}
    
    <style>
        .card {
            border-radius: 12px;
            box-shadow: 0 6px 12px rgba(0,0,0,0.15);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            margin-bottom: 30px;
        }
        .card-header {
            background-color: #007bff;
            color: white;
            border-radius: 12px 12px 0 0;
            padding: 15px;
            font-weight: bold;
        }
        h1 {
            font-size: 2rem;
            color: #343a40;
        }
        .btn-primary {
            border-radius: 8px;
            padding: 8px 16px;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container-fluid py-5">
    <h1 class="mb-5 text-center">Modifier la Caisse pour l'Année {{ caisse.annee }}</h1>

    <div class="card mb-5">
        <div class="card-header">
            Modifier le Solde de la Caisse
        </div>
        <div class="card-body">
            {{ form_start(caisseForm) }}
            <div class="row">
                <div class="col-md-4">
                    {{ form_row(caisseForm.solde, {'attr': {'class': 'form-control'}}) }}
                </div>
                <div class="col-md-4">
                    {{ form_row(caisseForm.annee, {'attr': {'class': 'form-control'}}) }}
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary mt-4">Mettre à jour</button>
                </div>
            </div>
            {{ form_end(caisseForm) }}
        </div>
    </div>

    <a href="{{ path('app_dashboard') }}" class="btn btn-secondary">Retour au Tableau de Bord</a>
</div>
{% endblock %}