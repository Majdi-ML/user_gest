<form method="post" action="{{ path('app_depense_delete', {'id': depense.id}) }}" class="delete-form" onsubmit="return confirm('⚠️ Êtes-vous sûr de vouloir supprimer cette dépense ? Cette action est irréversible.');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ depense.id) }}">
    <button type="submit" class="btn btn-danger">
        <i class="bi bi-trash"></i> Supprimer cette dépense
    </button>
</form>