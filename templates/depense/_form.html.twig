<div class="depense-form">
    {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': 'novalidate'}}) }}
    
    <div class="row">
        <div class="col-md-6 mb-3">
            {{ form_row(form.montant, {
                'label': 'Montant (TND)',
                'attr': {'class': 'form-control', 'placeholder': 'Ex: 150.00'}
            }) }}
        </div>
        <div class="col-md-6 mb-3">
            {{ form_row(form.date_depense, {
                'label': 'Date de la dépense',
                'attr': {'class': 'form-control'}
            }) }}
        </div>
    </div>
    
    <div class="row">
        <div class="col-md-6 mb-3">
            {{ form_row(form.type, {
                'label': 'Type de dépense',
                'attr': {'class': 'form-select'}
            }) }}
        </div>
        <div class="col-md-6 mb-3">
            {{ form_row(form.nature_depense, {
                'label': 'Nature de paiement',
                'attr': {'class': 'form-select'}
            }) }}
        </div>
    </div>
    
    <div class="mb-3">
        {{ form_row(form.description, {
            'label': 'Description',
            'attr': {'class': 'form-control', 'rows': 3, 'placeholder': 'Décrivez cette dépense...'}
        }) }}
    </div>
    
    <div class="mb-3">
        {{ form_row(form.file, {
            'label': 'Fichier joint (facture, reçu, etc.)',
            'attr': {'class': 'form-control'}
        }) }}
    </div>
    
    <div class="d-flex justify-content-end gap-2 mt-4">
        <a href="{{ path('app_depense_index') }}" class="btn btn-secondary">
            <i class="bi bi-x-circle"></i> Annuler
        </a>
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-circle"></i> {{ button_label|default('Enregistrer') }}
        </button>
    </div>
    
    {{ form_end(form) }}
</div>

<style>
.depense-form .form-label {
    font-weight: 500;
    color: #334155;
    margin-bottom: 0.5rem;
}
.depense-form .form-control,
.depense-form .form-select {
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 0.625rem 0.875rem;
}
.depense-form .form-control:focus,
.depense-form .form-select:focus {
    border-color: #667eea;
    box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
}
</style>
