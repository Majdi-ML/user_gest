{% extends 'base.html.twig' %}

{% block title %}Nouvelle Dépense{% endblock %}

{% block css %}
    {{ parent() }}
    <style>
        .page-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 16px;
            padding: 2rem;
            margin-bottom: 2rem;
            box-shadow: 0 8px 16px rgba(102, 126, 234, 0.2);
        }
        .page-header h1 {
            color: white;
            font-weight: 700;
            margin-bottom: 0.5rem;
            font-size: 1.75rem;
        }
        .page-subtitle {
            color: rgba(255, 255, 255, 0.9);
            font-size: 0.95rem;
        }
        .form-card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        }
        .form-card .card-header {
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
            border-bottom: 1px solid #e2e8f0;
            border-radius: 12px 12px 0 0 !important;
            font-weight: 600;
            color: #334155;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container-fluid p-4">
    <div class="page-header">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1><i class="bi bi-plus-circle-fill"></i> Nouvelle Dépense</h1>
                <p class="page-subtitle mb-0">Ajoutez une nouvelle dépense dans le système</p>
            </div>
            <a href="{{ path('app_depense_index') }}" class="btn btn-light">
                <i class="bi bi-arrow-left"></i> Retour à la liste
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card form-card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-file-earmark-plus"></i> Informations de la Dépense</h5>
                </div>
                <div class="card-body">
                    {{ include('depense/_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
