{% extends 'base.html.twig' %}

{% block title %}Détail Dépense{% endblock %}

{% block css %}
    {{ parent() }}
    <style>
        .page-header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 16px;
            padding: 2rem;
            margin-bottom: 2rem;
            box-shadow: 0 8px 16px rgba(102, 126, 234, 0.2);
        }
        .page-header h1 {
            color: white;
            font-weight: 700;
            margin-bottom: 0.5rem;
            font-size: 1.75rem;
        }
        .page-subtitle {
            color: rgba(255, 255, 255, 0.9);
            font-size: 0.95rem;
        }
        .detail-card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
            margin-bottom: 1.5rem;
        }
        .detail-card .card-header {
            background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
            border-bottom: 1px solid #e2e8f0;
            border-radius: 12px 12px 0 0 !important;
            font-weight: 600;
            color: #334155;
        }
        .detail-row {
            display: flex;
            padding: 1rem 0;
            border-bottom: 1px solid #f1f5f9;
        }
        .detail-row:last-child {
            border-bottom: none;
        }
        .detail-label {
            font-weight: 600;
            color: #64748b;
            width: 200px;
            flex-shrink: 0;
        }
        .detail-value {
            color: #334155;
            flex-grow: 1;
        }
        .badge-modern {
            padding: 0.5rem 1rem;
            border-radius: 6px;
            font-weight: 500;
            font-size: 0.875rem;
        }
        .action-buttons {
            display: flex;
            gap: 0.75rem;
            justify-content: flex-end;
        }
        .delete-section {
            margin-top: 2rem;
            padding: 1.5rem;
            background-color: #fef2f2;
            border: 1px solid #fecaca;
            border-radius: 8px;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container-fluid p-4">
    <div class="page-header">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h1><i class="bi bi-file-earmark-text"></i> Détail de la Dépense</h1>
                <p class="page-subtitle mb-0">Informations complètes de la dépense</p>
            </div>
            <div class="action-buttons">
                <a href="{{ path('app_depense_index') }}" class="btn btn-light">
                    <i class="bi bi-arrow-left"></i> Retour
                </a>
                <a href="{{ path('app_depense_edit', {'id': depense.id}) }}" class="btn btn-warning">
                    <i class="bi bi-pencil"></i> Modifier
                </a>
            </div>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card detail-card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-info-circle"></i> Informations Générales</h5>
                </div>
                <div class="card-body">
                    <div class="detail-row">
                        <div class="detail-label"><i class="bi bi-currency-dollar"></i> Montant</div>
                        <div class="detail-value">
                            <strong class="text-primary" style="font-size: 1.25rem;">{{ depense.montant|number_format(2, '.', ',') }} TND</strong>
                        </div>
                    </div>
                    
                    <div class="detail-row">
                        <div class="detail-label"><i class="bi bi-calendar-event"></i> Date de dépense</div>
                        <div class="detail-value">{{ depense.dateDepense ? depense.dateDepense|date('d/m/Y') : '—' }}</div>
                    </div>
                    
                    <div class="detail-row">
                        <div class="detail-label"><i class="bi bi-tag"></i> Type</div>
                        <div class="detail-value">
                            <span class="badge bg-info">{{ depense.type }}</span>
                        </div>
                    </div>
                    
                    <div class="detail-row">
                        <div class="detail-label"><i class="bi bi-wallet2"></i> Nature</div>
                        <div class="detail-value">
                            <span class="badge-modern {% if depense.natureDepense == 'Bancaire' %}bg-primary{% else %}bg-warning{% endif %}">
                                {{ depense.natureDepense }}
                            </span>
                        </div>
                    </div>
                    
                    <div class="detail-row">
                        <div class="detail-label"><i class="bi bi-file-text"></i> Description</div>
                        <div class="detail-value">{{ depense.description|default('—') }}</div>
                    </div>
                    
                    <div class="detail-row">
                        <div class="detail-label"><i class="bi bi-paperclip"></i> Fichier joint</div>
                        <div class="detail-value">
                            {% if depense.attachedFile %}
                                {% if depense.attachedFile ends with '.pdf' %}
                                    <a href="{{ asset('uploads/depenses/' ~ depense.attachedFile) }}" target="_blank" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-file-pdf"></i> Voir le PDF
                                    </a>
                                {% else %}
                                    <a href="{{ asset('uploads/depenses/' ~ depense.attachedFile) }}" target="_blank">
                                        <img src="{{ asset('uploads/depenses/' ~ depense.attachedFile) }}" 
                                             alt="Fichier joint" 
                                             style="max-height: 300px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                                    </a>
                                {% endif %}
                            {% else %}
                                <span class="text-muted">Aucun fichier joint</span>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>

            <div class="delete-section">
                <h5 class="text-danger"><i class="bi bi-exclamation-triangle"></i> Zone dangereuse</h5>
                <p class="text-muted mb-3">La suppression est irréversible. Veuillez confirmer avant de continuer.</p>
                {{ include('depense/_delete_form.html.twig') }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
