{% extends 'base.html.twig' %}

{% block title %}Liste des Cotisations Syndic{% endblock %}

{% block css %}
    {{ parent() }}
    {% include '_modern_index_styles.html.twig' %}
    <link href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" rel="stylesheet">
    <style>
        .filter-row th { padding: 8px 3px !important; vertical-align: top; }
        .filter-container { display: flex; gap: 5px; align-items: center; margin-bottom: 10px; }
        .filter-select { width: 100%; min-width: 120px; }
        .filter-input { width: 100%; min-width: 150px; }
        .btn-add-condition { margin-top: 5px; }
        .date-filter { display: none; }
        .logic-operator { font-weight: bold; margin: 0 10px; }
        .export-buttons { margin-bottom: 20px; }
        .nav-tabs { margin-bottom: 10px; }
        .paid-month { color: #10b981; font-weight: 600; }
        .unpaid-month { color: #ef4444; font-weight: 600; }
        .table-responsive { overflow-x: auto; }
        .table { font-size: 0.85rem; }
        .month-btn { font-size: 0.8rem; padding: 2px 6px; }
        .table-footer { font-weight: bold; background: linear-gradient(135deg, #f3f4f6 0%, #e5e7eb 100%); }
        .sortable { cursor: pointer; }
        .sortable::after { content: ''; display: inline-block; width: 0; height: 0; margin-left: 5px; border-left: 5px solid transparent; border-right: 5px solid transparent; }
        .sortable.asc::after { border-bottom: 5px solid #7c3aed; }
        .sortable.desc::after { border-top: 5px solid #7c3aed; }
        .nav-tabs .nav-link.active { 
            background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%); 
            color: white;
            border-color: #7c3aed;
        }
        .nav-tabs .nav-link { color: #7c3aed; border-color: #e5e7eb; }
        .nav-tabs .nav-link:hover { border-color: #7c3aed; background-color: #f3e8ff; }
    </style>
{% endblock %}

{% block body %}
<div class="container-fluid p-4">
    <div class="page-header">
        <div class="page-header-content">
            <div>
                <h1><i class="bi bi-cash-coin"></i> Cotisation Syndic</h1>
                <p class="page-subtitle">Gestion des règlements mensuels</p>
            </div>
            <div class="page-header-actions">
                <a href="{{ path('app_frais_syndic_reglement_new') }}" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Nouveau Règlement
                </a>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Filtres Avancés</h5>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="filterLogic" value="AND" checked>
                    <label class="form-check-label" for="filterLogicAnd">Toutes les conditions</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="filterLogic" id="filterLogicOr" value="OR">
                    <label class="form-check-label" for="filterLogicOr">Au moins une condition (OR)</label>
                </div>
            </div>
            
            <div id="filterBuilder"></div>
            <button id="addFilterBtn" class="btn btn-primary btn-sm btn-add-condition mt-2">
                <i class="bi bi-plus"></i> Ajouter une condition
            </button>
            <button id="applyFiltersBtn" class="btn btn-success btn-sm mt-2">
                <i class="bi bi-funnel"></i> Appliquer les filtres
            </button>
            <button id="resetFiltersBtn" class="btn btn-danger btn-sm mt-2">
                <i class="bi bi-x-circle"></i> Réinitialiser
            </button>
        </div>
    </div>

    <div class="export-buttons text-end">
        <button id="exportPdfBtn" class="btn btn-danger btn-sm me-2">
            <i class="bi bi-file-pdf"></i> Exporter en PDF
        </button>
        <button id="exportExcelBtn" class="btn btn-success btn-sm">
            <i class="bi bi-file-excel"></i> Exporter en Excel
        </button>
    </div>

    <ul class="nav nav-tabs" id="yearTabs" role="tablist">
        {% for year, yearData in dataByYear|sort %}
            <li class="nav-item" role="presentation">
                <button class="nav-link {% if loop.first %}active{% endif %}" id="year-{{ year }}-tab" data-bs-toggle="tab" data-bs-target="#year-{{ year }}" type="button" role="tab" aria-controls="year-{{ year }}" aria-selected="{{ loop.first ? 'true' : 'false' }}">{{ year }}</button>
            </li>
        {% endfor %}
    </ul>

    <div class="tab-content" id="yearTabContent">
        {% for year, yearData in dataByYear|sort %}
            <div class="tab-pane fade {% if loop.first %}show active{% endif %}" id="year-{{ year }}" role="tabpanel" aria-labelledby="year-{{ year }}-tab">
                <div class="table-responsive">
                    <table id="fraisSyndicReglementsTable-{{ year }}" class="table table-bordered table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th class="sortable" data-sort="appartement">Appartement</th>
                                <th class="sortable" data-sort="nom">Propriétaire</th>
                                <th>Année</th>
                                <th>Jan</th>
                                <th>Fév</th>
                                <th>Mar</th>
                                <th>Avr</th>
                                <th>Mai</th>
                                <th>Juin</th>
                                <th>Juil</th>
                                <th>Août</th>
                                <th>Sep</th>
                                <th>Oct</th>
                                <th>Nov</th>
                                <th>Déc</th>
                                <th>Total</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for appartement, data in yearData %}
                                <tr data-nom="{{ data.nom }}"
                                    data-appartement="{{ data.appartement }}"
                                    data-proprietaire="{{ data.proprietaire }}"
                                    data-annee="{{ year }}"
                                    data-details="{{ data.details|json_encode|escape('html_attr') }}"
                                    data-appartement-id="{{ data.appartementId }}">
                                    <td>{{ data.appartement }}</td>
                                    <td>{{ data.nom }}</td>
                                    <td>{{ year }}</td>
                                    {% for month in 1..12 %}
                                        {% set isPaid = data.months[month] is defined and data.months[month] == 'Oui' %}
                                        <td class="text-center {% if isPaid %}paid-month{% else %}unpaid-month{% endif %}">
                                            {{ isPaid ? '✅' : '❌' }}
                                        </td>
                                    {% endfor %}
                                    <td class="text-center">
    {{ data.details[0].montant|default(0) }} TND
</td>
                                    <td class="table-actions">
                                        {% if data.details[0] is defined and data.details[0].id is defined %}
                                            <a href="{{ path('app_frais_syndic_reglement_show', {'id': data.details[0].id}) }}" class="btn btn-info">
                                                <i class="bi bi-eye-fill"></i> Voir
                                            </a>
                                            <a href="{{ path('app_frais_syndic_reglement_edit', {'id': data.details[0].id}) }}" class="btn btn-warning">
                                                <i class="bi bi-pencil-fill"></i> Modifier
                                            </a>
                                        {% else %}
                                            <a href="{{ path('app_frais_syndic_reglement_new', {'appartementId': data.appartementId, 'annee': year}) }}" class="btn btn-success">
                                                <i class="bi bi-plus-circle"></i> Créer
                                            </a>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="17" class="text-center">Aucun règlement trouvé pour {{ year }}.</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                        <tfoot class="table-footer">
                            <tr>
                                <td colspan="15" class="text-end">Total pour {{ year }} :</td>
<td class="text-center">
    {% set yearTotal = 0 %}
    {% for appartement, data in yearData %}
        {% set yearTotal = yearTotal + (data.details[0].montant|default(0)) %}
    {% endfor %}
    {{ yearTotal }} TND
</td>
<td></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        {% endfor %}
    </div>
</div>

<script type="text/javascript">
    const fraisSyndicReglementsDataByYear = {
        {% for year, yearData in dataByYear|sort %}
            "{{ year }}": [
                {% for appartement, data in yearData %}
                    {
                        nom: "{{ data.nom }}",
                        appartement: "{{ data.appartement }}",
                        proprietaire: "{{ data.proprietaire }}",
                        appartementId: "{{ data.appartementId }}",
                        details: {{ data.details|json_encode|raw }},
                        months: {{ data.months|json_encode|raw }}
                    }{% if not loop.last %},{% endif %}
                {% endfor %}
            ]{% if not loop.last %},{% endif %}
        {% endfor %}
    };
</script>
{% endblock %}

{% block js %}
    {{ parent() }}
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/fr.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script>
        $(document).ready(function() {
            $('[data-bs-toggle="tooltip"]').tooltip();

            const columnData = {
                nom: { type: 'text', display: 'Nom' },
                appartement: { type: 'text', display: 'Appartement' },
                proprietaire: { type: 'text', display: 'Propriétaire' },
                annee: { type: 'number', display: 'Année' },
                montant: { type: 'number', display: 'Montant' },
                'nature-paiement': { type: 'text', display: 'Nature Paiement' },
                utilisateur: { type: 'text', display: 'Utilisateur' }
            };
            
            const textOperators = [
                { id: 'equals', text: 'Égal à' },
                { id: 'not_equals', text: 'Différent de' },
                { id: 'contains', text: 'Contient' },
                { id: 'not_contains', text: 'Ne contient pas' },
                { id: 'starts_with', text: 'Commence par' },
                { id: 'ends_with', text: 'Finit par' },
                { id: 'empty', text: 'Est vide' },
                { id: 'not_empty', text: "N'est pas vide" }
            ];
            
            const numberOperators = [
                { id: 'equals', text: 'Égal à (=)' },
                { id: 'not_equals', text: 'Différent de (!=)' },
                { id: 'greater', text: 'Supérieur à (>)' },
                { id: 'greater_equal', text: 'Supérieur ou égal (>=)' },
                { id: 'less', text: 'Inférieur à (<)' },
                { id: 'less_equal', text: 'Inférieur ou égal (<=)' },
                { id: 'empty', text: 'Est vide' },
                { id: 'not_empty', text: "N'est pas vide" }
            ];
            
            function addFilter() {
                const filterId = Date.now();
                const filterHtml = `
                <div class="filter-container" data-filter-id="${filterId}">
                    <select class="form-select form-select-sm filter-column" style="width: 150px;">
                        ${Object.keys(columnData).map(col => 
                            `<option value="${col}">${columnData[col].display}</option>`
                        ).join('')}
                    </select>
                    <select class="form-select form-select-sm filter-operator" style="width: 180px;">
                        ${textOperators.map(op => `<option value="${op.id}">${op.text}</option>`).join('')}
                    </select>
                    <input type="text" class="form-control form-control-sm filter-value" placeholder="Valeur" style="display: none;">
                    <input type="number" class="form-control form-control-sm filter-value-number number-filter" placeholder="Valeur numérique" style="display: none;">
                    <button class="btn btn-danger btn-sm remove-filter" type="button">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
                `;
                $('#filterBuilder').append(filterHtml);
                
                $(`[data-filter-id="${filterId}"] .filter-column`).change(function() {
                    updateFilterInputs(filterId);
                }).trigger('change');
                
                $(`[data-filter-id="${filterId}"] .filter-operator`).change(function() {
                    updateFilterInputs(filterId);
                });
            }
            
            function updateFilterInputs(filterId) {
                const container = $(`[data-filter-id="${filterId}"]`);
                const column = container.find('.filter-column').val();
                const operator = container.find('.filter-operator').val();
                const columnType = columnData[column].type;
                
                let operators;
                if (columnType === 'number') operators = numberOperators;
                else operators = textOperators;
                
                const operatorSelect = container.find('.filter-operator');
                const currentOperator = operatorSelect.val();
                operatorSelect.empty();
                operators.forEach(op => {
                    operatorSelect.append(`<option value="${op.id}">${op.text}</option>`);
                });
                
                if (operators.some(op => op.id === currentOperator)) {
                    operatorSelect.val(currentOperator);
                }
                
                container.find('.filter-value, .filter-value-number').hide();
                
                if (operator === 'empty' || operator === 'not_empty') {
                } else {
                    if (columnType === 'number') {
                        container.find('.filter-value-number').show();
                    } else {
                        container.find('.filter-value').show();
                    }
                }
            }
            
            addFilter();
            
            $('#addFilterBtn').click(addFilter);
            
            $('#filterBuilder').on('click', '.remove-filter', function() {
                $(this).closest('.filter-container').remove();
            });
            
            $('#applyFiltersBtn').click(function() {
                const filters = [];
                const logic = $('input[name="filterLogic"]:checked').val();
                
                $('.filter-container').each(function() {
                    const column = $(this).find('.filter-column').val();
                    const operator = $(this).find('.filter-operator').val();
                    let value1;
                    
                    if (operator === 'empty' || operator === 'not_empty') {
                        filters.push({ column, operator, logic });
                        return;
                    }
                    
                    if (columnData[column].type === 'number') {
                        value1 = $(this).find('.filter-value-number').val();
                    } else {
                        value1 = $(this).find('.filter-value').val();
                    }
                    if (!value1) return;
                    
                    filters.push({ column, operator, value1, logic });
                });
                
                applyFilters(filters, logic);
            });
            
            $('#resetFiltersBtn').click(function() {
                $('#filterBuilder').empty();
                addFilter();
                $('.tab-pane table tbody tr').show();
                $('.tab-pane table tfoot').show();
            });
            
            function applyFilters(filters, logic) {
                if (filters.length === 0) {
                    $('.tab-pane table tbody tr').show();
                    $('.tab-pane table tfoot').show();
                    return;
                }
                
                $('.tab-pane').each(function() {
                    const year = $(this).attr('id').replace('year-', '');
                    const yearData = fraisSyndicReglementsDataByYear[year] || [];
                    
                    let anyRowVisible = false;
                    $(this).find('tbody tr').each(function() {
                        const row = $(this);
                        const rowNom = row.data('nom');
                        const rowAppartement = row.data('appartement');
                        const rowProprietaire = row.data('proprietaire');
                        const rowAnnee = row.data('annee');
                        let details;
                        try {
                            details = JSON.parse(row.data('details'));
                        } catch (e) {
                            console.error('Invalid JSON in data-details:', row.data('details'));
                            details = [];
                        }
                        let matchResults = [];
                        
                        filters.forEach(filter => {
                            const column = filter.column;
                            const operator = filter.operator;
                            let matches = false;
                            
                            if (['nom', 'appartement', 'proprietaire', 'annee'].includes(column)) {
                                let value = row.data(column);
                                if (value === '' || value === null || value === undefined) {
                                    if (operator === 'empty') matches = true;
                                    else if (operator === 'not_empty') matches = false;
                                    else matches = false;
                                    matchResults.push(matches);
                                    return;
                                }
                                
                                if (column === 'annee') {
                                    value = parseFloat(value);
                                    const filterValue = parseFloat(filter.value1);
                                    switch(operator) {
                                        case 'equals': matches = value === filterValue; break;
                                        case 'not_equals': matches = value !== filterValue; break;
                                        case 'greater': matches = value > filterValue; break;
                                        case 'greater_equal': matches = value >= filterValue; break;
                                        case 'less': matches = value < filterValue; break;
                                        case 'less_equal': matches = value <= filterValue; break;
                                    }
                                } else {
                                    value = String(value).toLowerCase();
                                    const filterValue = String(filter.value1).toLowerCase();
                                    switch(operator) {
                                        case 'equals': matches = value === filterValue; break;
                                        case 'not_equals': matches = value !== filterValue; break;
                                        case 'contains': matches = value.includes(filterValue); break;
                                        case 'not_contains': matches = !value.includes(filterValue); break;
                                        case 'starts_with': matches = value.startsWith(filterValue); break;
                                        case 'ends_with': matches = value.endsWith(filterValue); break;
                                    }
                                }
                                matchResults.push(matches);
                                return;
                            }
                            
                            let detailMatches = details.map(detail => {
                                let value = detail[column];
                                if (value === '' || value === null || value === undefined) {
                                    if (operator === 'empty') return true;
                                    else if (operator === 'not_empty') return false;
                                    else return false;
                                }
                                
                                if (columnData[column].type === 'number') {
                                    value = parseFloat(value);
                                    const filterValue = parseFloat(filter.value1);
                                    switch(operator) {
                                        case 'equals': return value === filterValue;
                                        case 'not_equals': return value !== filterValue;
                                        case 'greater': return value > filterValue;
                                        case 'greater_equal': return value >= filterValue;
                                        case 'less': return value < filterValue;
                                        case 'less_equal': return value <= filterValue;
                                        case 'empty': return isNaN(value);
                                        case 'not_empty': return !isNaN(value);
                                    }
                                } else {
                                    value = String(value).toLowerCase();
                                    const filterValue = String(filter.value1).toLowerCase();
                                    switch(operator) {
                                        case 'equals': return value === filterValue;
                                        case 'not_equals': return value !== filterValue;
                                        case 'contains': return value.includes(filterValue);
                                        case 'not_contains': return !value.includes(filterValue);
                                        case 'starts_with': return value.startsWith(filterValue);
                                        case 'ends_with': return value.endsWith(filterValue);
                                    }
                                }
                                return false;
                            });
                            
                            matches = detailMatches.some(m => m);
                            matchResults.push(matches);
                        });
                        
                        let shouldShow;
                        if (logic === 'AND') {
                            shouldShow = matchResults.length > 0 && matchResults.every(m => m);
                        } else {
                            shouldShow = matchResults.some(m => m);
                        }
                        
                        row.toggle(shouldShow);
                        if (shouldShow) anyRowVisible = true;
                    });
                    
                    $(this).find('tfoot').toggle(anyRowVisible);
                });
            }

            function collectVisibleData() {
                const activeYear = $('#yearTabs .nav-link.active').text();
                const table = $(`#fraisSyndicReglementsTable-${activeYear}`);
                
                const headers = [];
                table.find('thead th').each(function() {
                    headers.push($(this).text());
                });
                
                const data = [];
                table.find('tbody tr:visible').each(function() {
                    const rowData = {};
                    $(this).find('td').each(function(index) {
                        const header = headers[index];
                        if (['Jan', 'Fév', 'Mar', 'Avr', 'Mai', 'Juin', 'Juil', 'Août', 'Sep', 'Oct', 'Nov', 'Déc'].includes(header)) {
                            rowData[header] = $(this).text().trim() === '✅' ? 'Oui' : 'Non';
                        } else if (header === 'Actions') {
                            rowData[header] = '';
                        } else {
                            rowData[header] = $(this).text().trim();
                        }
                    });
                    data.push(rowData);
                });
                
                // Add total row for export
                const totalRow = {};
                headers.forEach(header => {
                    if (header === 'Total') {
                        let yearTotal = 0;
                        table.find('tbody tr:visible').each(function() {
                            let details;
                            try {
                                details = JSON.parse($(this).data('details'));
                                if (details.length > 0) {
                                    yearTotal += parseFloat(details[0].montant || 0);
                                }
                            } catch (e) {
                                console.error('Invalid JSON in collectVisibleData:', $(this).data('details'));
                            }
                        });
                        totalRow[header] = yearTotal.toFixed(2) + ' TND';
                    } else if (['Appartement', 'Propriétaire', 'Année', 'Actions'].includes(header)) {
                        totalRow[header] = header === 'Appartement' ? 'Total' : '';
                    } else {
                        totalRow[header] = '';
                    }
                });
                data.push(totalRow);
                
                return {
                    year: activeYear,
                    headers: headers,
                    data: data
                };
            }

            $('#exportPdfBtn').click(function() {
                const { jsPDF } = window.jspdf;
                const doc = new jsPDF({
                    orientation: 'landscape',
                    unit: 'mm'
                });
                
                const { year, headers, data } = collectVisibleData();
                
                doc.setFontSize(12);
                doc.text(`Cotisation Syndic - Année ${year}`, 14, 10);
                
                const exportDate = new Date().toLocaleDateString('fr-FR');
                doc.setFontSize(8);
                doc.text(`Exporté le: ${exportDate}`, doc.internal.pageSize.width - 40, 10);
                
                const tableData = data.map(row => headers.map(header => row[header]));
                
                const options = {
                    startY: 15,
                    margin: { top: 15 },
                    headStyles: {
                        fillColor: [51, 122, 183],
                        textColor: 255,
                        fontSize: 8
                    },
                    bodyStyles: {
                        fontSize: 7,
                        cellPadding: 2
                    },
                    columnStyles: {
                        0: { cellWidth: 20 },
                        1: { cellWidth: 30 },
                        2: { cellWidth: 15 },
                        3: { cellWidth: 10 },
                        4: { cellWidth: 10 },
                        5: { cellWidth: 10 },
                        6: { cellWidth: 10 },
                        7: { cellWidth: 10 },
                        8: { cellWidth: 10 },
                        9: { cellWidth: 10 },
                        10: { cellWidth: 10 },
                        11: { cellWidth: 10 },
                        12: { cellWidth: 10 },
                        13: { cellWidth: 10 },
                        14: { cellWidth: 10 },
                        15: { cellWidth: 15 },
                        16: { cellWidth: 25 }
                    },
                    styles: {
                        overflow: 'linebreak',
                        fontSize: 7
                    },
                    footStyles: {
                        fillColor: [200, 200, 200],
                        textColor: 0,
                        fontSize: 7,
                        fontStyle: 'bold'
                    }
                };
                
                doc.autoTable({
                    head: [headers],
                    body: tableData,
                    ...options
                });
                
                doc.save(`frais-syndic-${year}.pdf`);
            });

            $('#exportExcelBtn').click(function() {
                const { year, headers, data } = collectVisibleData();
                
                const wb = XLSX.utils.book_new();
                
                const wsData = [
                    headers,
                    ...data.map(row => headers.map(header => row[header]))
                ];
                
                const ws = XLSX.utils.aoa_to_sheet(wsData);
                
                XLSX.utils.book_append_sheet(wb, ws, `Cotisation Syndic ${year}`);
                
                XLSX.writeFile(wb, `frais-syndic-${year}.xlsx`);
            });

            // Sorting functionality
            $('.sortable').click(function() {
                const table = $(this).closest('table');
                const column = $(this).data('sort');
                const isAsc = $(this).hasClass('asc');
                
                // Reset all sort indicators
                table.find('.sortable').removeClass('asc desc');
                
                // Set new sort indicator
                $(this).addClass(isAsc ? 'desc' : 'asc');
                
                const sortOrder = isAsc ? -1 : 1;
                
                const rows = table.find('tbody tr').get();
                rows.sort(function(a, b) {
                    const aValue = $(a).data(column).toString().toLowerCase();
                    const bValue = $(b).data(column).toString().toLowerCase();
                    return aValue.localeCompare(bValue) * sortOrder;
                });
                
                table.find('tbody').empty().append(rows);
            });
        });
    </script>
{% endblock %}