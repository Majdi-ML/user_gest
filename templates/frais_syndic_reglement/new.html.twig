{% extends 'base.html.twig' %}

{% block title %}Ajouter Cotisation Syndic{% endblock %}

{% block css %}
    {{ parent() }}
    {% include '_modern_form_styles.html.twig' %}
    <style>
        /* Month cards grid */
        .months-grid {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            gap: 12px;
            padding: 1.5rem;
        }
        .month-card {
            position: relative;
            border: 2px solid #e5e7eb;
            border-radius: 12px;
            padding: 16px 10px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s ease;
            background: white;
            user-select: none;
        }
        .month-card:hover {
            border-color: #a78bfa;
            transform: translateY(-3px);
            box-shadow: 0 6px 16px rgba(124, 58, 237, 0.15);
        }
        .month-card.selected {
            background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%);
            border-color: #7c3aed;
            color: white;
            box-shadow: 0 6px 20px rgba(124, 58, 237, 0.3);
        }
        .month-card .month-icon {
            font-size: 1.8rem;
            margin-bottom: 6px;
            display: block;
        }
        .month-card .month-name {
            font-weight: 600;
            font-size: 0.85rem;
            display: block;
        }
        .month-card .month-check {
            position: absolute;
            top: 6px;
            right: 8px;
            font-size: 1rem;
            opacity: 0;
            transition: opacity 0.3s;
        }
        .month-card.selected .month-check {
            opacity: 1;
        }
        .month-card input[type="checkbox"] {
            display: none;
        }

        /* Appartement cards */
        .appartement-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            max-height: 350px;
            overflow-y: auto;
            padding: 1rem;
        }
        .appart-card {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 14px 18px;
            background: white;
            border: 2px solid #e5e7eb;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        .appart-card:hover {
            border-color: #7c3aed;
            background: rgba(124, 58, 237, 0.03);
            transform: translateX(4px);
        }
        .appart-card.selected {
            border-color: #7c3aed;
            background: linear-gradient(135deg, rgba(124, 58, 237, 0.08) 0%, rgba(124, 58, 237, 0.03) 100%);
        }
        .appart-card.selected .appart-icon {
            background: #7c3aed;
            color: white;
        }
        .appart-card .appart-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: #f3e8ff;
            color: #7c3aed;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            flex-shrink: 0;
            transition: all 0.3s;
        }
        .appart-card .appart-info {
            font-weight: 600;
            font-size: 0.88rem;
            color: #374151;
        }
        .appart-card .appart-info small {
            display: block;
            font-weight: 400;
            font-size: 0.78rem;
            color: #9ca3af;
        }
        .appart-card input[type="checkbox"] {
            display: none;
        }

        /* Section cards */
        .section-card {
            background: white;
            border: 2px solid #e5e7eb;
            border-radius: 14px;
            overflow: hidden;
            margin-bottom: 20px;
            transition: border-color 0.3s;
        }
        .section-card:hover {
            border-color: #d8b4fe;
        }
        .section-header {
            background: linear-gradient(135deg, #f9fafb 0%, #f3f4f6 100%);
            padding: 16px 20px;
            border-bottom: 2px solid #e5e7eb;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .section-header h6 {
            margin: 0;
            font-weight: 700;
            color: #374151;
            font-size: 1rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .section-header .badge-count {
            background: #7c3aed;
            color: white;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 0.78rem;
            font-weight: 600;
        }
        .section-body {
            padding: 0;
        }

        /* Controls bar */
        .controls-bar {
            display: flex;
            gap: 10px;
            align-items: center;
            padding: 12px 20px;
            background: #faf5ff;
            border-bottom: 1px solid #f3e8ff;
        }
        .controls-bar .btn-ctrl {
            padding: 6px 14px;
            border: 2px solid #7c3aed;
            background: white;
            color: #7c3aed;
            border-radius: 8px;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.82rem;
            transition: all 0.2s;
        }
        .controls-bar .btn-ctrl:hover {
            background: #7c3aed;
            color: white;
        }
        .controls-bar .search-input {
            border: 2px solid #e5e7eb;
            border-radius: 8px;
            padding: 6px 14px;
            font-size: 0.85rem;
            max-width: 280px;
            transition: border-color 0.3s;
        }
        .controls-bar .search-input:focus {
            outline: none;
            border-color: #7c3aed;
            box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.1);
        }

        /* Summary bar */
        .summary-bar {
            background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%);
            color: white;
            padding: 18px 24px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
            box-shadow: 0 4px 16px rgba(124, 58, 237, 0.25);
        }
        .summary-bar .summary-item {
            text-align: center;
        }
        .summary-bar .summary-value {
            font-size: 1.5rem;
            font-weight: 700;
        }
        .summary-bar .summary-label {
            font-size: 0.8rem;
            opacity: 0.85;
        }

        /* Form row */
        .form-card {
            padding: 30px;
        }

        @media (max-width: 992px) {
            .months-grid { grid-template-columns: repeat(4, 1fr); }
            .appartement-grid { grid-template-columns: repeat(2, 1fr); }
        }
        @media (max-width: 576px) {
            .months-grid { grid-template-columns: repeat(3, 1fr); }
            .appartement-grid { grid-template-columns: 1fr; }
            .summary-bar { flex-direction: column; gap: 12px; }
        }
    </style>
{% endblock %}

{% block body %}
<div class="container-fluid p-4 fade-in">
    <div class="page-header">
        <h1>
            <span class="page-header-icon"><i class="bi bi-plus-circle-fill"></i></span>
            Ajouter Cotisation Syndic
        </h1>
        <p class="mb-0 mt-2" style="opacity: 0.9;">Enregistrer un nouveau reglement de cotisation</p>
    </div>

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {{ form_start(form, {'attr': {'id': 'frais-form', 'novalidate': 'novalidate'}}) }}

    <!-- Summary Bar -->
    <div class="summary-bar" id="summary-bar">
        <div class="summary-item">
            <div class="summary-value" id="summary-apparts">0</div>
            <div class="summary-label">Appartements</div>
        </div>
        <div class="summary-item">
            <div class="summary-value" id="summary-months">0</div>
            <div class="summary-label">Mois selectionnes</div>
        </div>
        <div class="summary-item">
            <div class="summary-value" id="summary-montant">0 TND</div>
            <div class="summary-label">Montant mensuel</div>
        </div>
        <div class="summary-item">
            <div class="summary-value" id="summary-total">0 TND</div>
            <div class="summary-label">Total par appartement</div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Left column: Settings -->
        <div class="col-lg-4">
            <div class="section-card">
                <div class="section-header">
                    <h6><i class="bi bi-gear-fill" style="color: #7c3aed;"></i> Parametres</h6>
                </div>
                <div class="section-body" style="padding: 20px;">
                    <div class="mb-3">
                        {{ form_label(form.frais, 'Montant mensuel', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.frais, {'attr': {'class': 'form-select', 'id': 'frais-select'}}) }}
                        {{ form_errors(form.frais) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(form.annee, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.annee, {'attr': {'class': 'form-select', 'id': 'annee-select'}}) }}
                        {{ form_errors(form.annee) }}
                    </div>
                    <div class="mb-0">
                        {{ form_label(form.nature_paiement, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.nature_paiement, {'attr': {'class': 'form-select'}}) }}
                        {{ form_errors(form.nature_paiement) }}
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary btn-lg" style="border-radius: 12px; padding: 14px; font-weight: 600; box-shadow: 0 4px 12px rgba(124, 58, 237, 0.25);">
                    <i class="bi bi-check-circle-fill"></i> Enregistrer
                </button>
                <a href="{{ path('app_frais_syndic_reglement_index') }}" class="btn btn-secondary" style="border-radius: 12px; padding: 12px; font-weight: 600;">
                    <i class="bi bi-arrow-left-circle"></i> Retour a la liste
                </a>
            </div>
        </div>

        <!-- Right column: Months + Appartements -->
        <div class="col-lg-8">
            <!-- Months section -->
            <div class="section-card">
                <div class="section-header">
                    <h6><i class="bi bi-calendar-month-fill" style="color: #7c3aed;"></i> Mois a cocher <span class="badge-count" id="months-count">0 / 12</span></h6>
                    <div style="display: flex; gap: 8px;">
                        <button type="button" class="btn-ctrl" id="select-all-months">
                            <i class="bi bi-check-all"></i> Tous
                        </button>
                        <button type="button" class="btn-ctrl" id="deselect-all-months">
                            <i class="bi bi-x-lg"></i> Aucun
                        </button>
                    </div>
                </div>
                <div class="section-body">
                    <div class="months-grid">
                        {% set monthIcons = ['01', '02', '03', '04', '05', '06', '07', '08', '09', '10', '11', '12'] %}
                        {% set monthEmojis = ['❄️', '💧', '🌸', '🌷', '☀️', '🌞', '🏖️', '🌅', '🍂', '🎃', '🍁', '🎄'] %}
                        {% set monthNames = ['Janvier', 'Fevrier', 'Mars', 'Avril', 'Mai', 'Juin', 'Juillet', 'Aout', 'Septembre', 'Octobre', 'Novembre', 'Decembre'] %}
                        {% set monthLabels = ['Janvier', 'Fevrier', 'Mars', 'Avril', 'Mai', 'Juin', 'Juillet', 'Aout', 'Septembre', 'Octobre', 'Novembre', 'Decembre'] %}

                        {% for i in 0..11 %}
                            <label class="month-card" data-month="{{ monthNames[i] }}">
                                {{ form_widget(attribute(form, monthNames[i]), {'attr': {'class': 'month-cb'}}) }}
                                <span class="month-icon">{{ monthEmojis[i] }}</span>
                                <span class="month-name">{{ monthLabels[i] }}</span>
                                <span class="month-check"><i class="bi bi-check-circle-fill"></i></span>
                            </label>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <!-- Appartements section -->
            <div class="section-card">
                <div class="section-header">
                    <h6><i class="bi bi-building-fill" style="color: #7c3aed;"></i> Appartements <span class="badge-count" id="apparts-count">0</span></h6>
                    <div style="display: flex; gap: 8px;">
                        <button type="button" class="btn-ctrl" id="select-all-apparts">
                            <i class="bi bi-check-all"></i> Tous
                        </button>
                        <button type="button" class="btn-ctrl" id="deselect-all-apparts">
                            <i class="bi bi-x-lg"></i> Aucun
                        </button>
                    </div>
                </div>
                <div class="controls-bar">
                    <input type="text" id="search-appartement" class="search-input flex-grow-1" placeholder="Rechercher un appartement...">
                </div>
                <div class="section-body">
                    <div class="appartement-grid" id="appartement-list">
                        <div class="text-center text-muted py-4">
                            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                            Chargement des appartements...
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {{ form_widget(form.appartement, {'attr': {'style': 'display:none', 'id': 'hidden-appartement-select'}}) }}
    {{ form_errors(form.appartement) }}
    {{ form_errors(form.Janvier) }}
    {{ form_end(form) }}
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
$(document).ready(function () {
    const hiddenSelect = $('#hidden-appartement-select').length
        ? $('#hidden-appartement-select')
        : $('select[name*="[appartement]"]').first();
    const fieldName = hiddenSelect.attr('name')
        ? hiddenSelect.attr('name').replace('[]', '')
        : 'frais_syndic_reglement[appartement]';

    // ===== Month cards =====
    function initMonthCards() {
        $('.month-card').each(function() {
            const cb = $(this).find('.month-cb');
            if (cb.is(':checked')) {
                $(this).addClass('selected');
            }
        });
        updateSummary();
    }

    $(document).on('click', '.month-card', function(e) {
        // Prevent double-triggering from label>input
        if (e.target.tagName === 'INPUT') return;
        const cb = $(this).find('.month-cb');
        cb.prop('checked', !cb.prop('checked'));
        $(this).toggleClass('selected', cb.prop('checked'));
        updateSummary();
    });

    // Sync if checkbox changes directly
    $(document).on('change', '.month-cb', function() {
        $(this).closest('.month-card').toggleClass('selected', $(this).is(':checked'));
        updateSummary();
    });

    $('#select-all-months').on('click', function() {
        $('.month-cb').prop('checked', true);
        $('.month-card').addClass('selected');
        updateSummary();
    });

    $('#deselect-all-months').on('click', function() {
        $('.month-cb').prop('checked', false);
        $('.month-card').removeClass('selected');
        updateSummary();
    });

    // ===== Appartements =====
    function loadAppartements() {
        $.ajax({
            url: '/frais_syndic_reglement/get-all-appartements',
            method: 'GET',
            success: function(data) {
                const list = $('#appartement-list');
                list.empty();

                if (data.length > 0) {
                    data.forEach(function(appart) {
                        list.append(`
                            <label class="appart-card" data-search="${appart.text.toLowerCase()}">
                                <input type="checkbox" name="${fieldName}[]" value="${appart.id}" class="appartement-checkbox">
                                <div class="appart-icon"><i class="bi bi-house-door-fill"></i></div>
                                <div class="appart-info">
                                    Appart ${appart.numero}
                                    <small>${appart.proprietaire}</small>
                                </div>
                            </label>
                        `);
                    });
                    syncAppartementSelection();
                } else {
                    list.html('<div class="text-center text-muted py-4">Aucun appartement disponible</div>');
                }
                updateSummary();
            },
            error: function() {
                $('#appartement-list').html('<div class="text-center text-danger py-4"><i class="bi bi-exclamation-triangle"></i> Erreur de chargement</div>');
            }
        });
    }

    function syncAppartementSelection() {
        $(document).on('change', '.appartement-checkbox', function() {
            const card = $(this).closest('.appart-card');
            card.toggleClass('selected', $(this).is(':checked'));

            const selectedIds = [];
            $('.appartement-checkbox:checked').each(function() {
                selectedIds.push($(this).val());
            });
            hiddenSelect.val(selectedIds);
            updateSummary();
        });
    }

    $(document).on('click', '.appart-card', function(e) {
        if (e.target.tagName === 'INPUT') return;
        const cb = $(this).find('.appartement-checkbox');
        cb.prop('checked', !cb.prop('checked')).trigger('change');
    });

    $('#search-appartement').on('keyup', function() {
        const term = $(this).val().toLowerCase();
        $('.appart-card').each(function() {
            $(this).toggle($(this).data('search').includes(term));
        });
    });

    $('#select-all-apparts').on('click', function() {
        $('.appart-card:visible .appartement-checkbox').prop('checked', true).trigger('change');
        $('.appart-card:visible').addClass('selected');
    });

    $('#deselect-all-apparts').on('click', function() {
        $('.appart-card:visible .appartement-checkbox').prop('checked', false).trigger('change');
        $('.appart-card:visible').removeClass('selected');
    });

    // ===== Summary =====
    function getMontantMensuel() {
        const selected = $('#frais-select option:selected');
        if (selected.val()) {
            const text = selected.text();
            const match = text.match(/([\d,.]+)/);
            return match ? parseFloat(match[1].replace(',', '.')) : 0;
        }
        return 0;
    }

    function updateSummary() {
        const nbMonths = $('.month-cb:checked').length;
        const nbApparts = $('.appartement-checkbox:checked').length;
        const montant = getMontantMensuel();
        const totalPerAppart = nbMonths * montant;

        $('#summary-months').text(nbMonths);
        $('#months-count').text(nbMonths + ' / 12');
        $('#summary-apparts').text(nbApparts);
        $('#apparts-count').text(nbApparts);
        $('#summary-montant').text(montant.toFixed(2) + ' TND');
        $('#summary-total').text(totalPerAppart.toFixed(2) + ' TND');
    }

    $('#frais-select').on('change', function() {
        updateSummary();
    });

    // ===== Init =====
    loadAppartements();
    initMonthCards();
});
</script>
{% endblock %}
