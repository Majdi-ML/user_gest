{% extends 'base.html.twig' %}

{% block title %}Ajouter Cotisation Syndic{% endblock %}

{% block css %}
    {{ parent() }}
    {% include '_modern_form_styles.html.twig' %}
    <style>
        .checkbox-group { 
            display: grid; 
            grid-template-columns: repeat(4, 1fr); 
            gap: 15px; 
            background: #fff; 
            padding: 1rem; 
            border: 1px solid #e5e7eb; 
            border-radius: 8px; 
        }
        .appartement-checkbox-group {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            background: #fff;
            padding: 1.5rem;
            border: 2px solid #7c3aed;
            border-radius: 12px;
            max-height: 400px;
            overflow-y: auto;
        }
        .appartement-checkbox-label {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 16px;
            background: linear-gradient(135deg, rgba(124, 58, 237, 0.05) 0%, rgba(124, 58, 237, 0.02) 100%);
            border: 2px solid #e5e7eb;
            border-radius: 8px;
            font-size: 0.9rem;
            transition: all 0.3s ease;
            cursor: pointer;
        }
        .appartement-checkbox-label:hover {
            background: linear-gradient(135deg, rgba(124, 58, 237, 0.1) 0%, rgba(124, 58, 237, 0.05) 100%);
            border-color: #7c3aed;
            transform: translateX(4px);
        }
        .appartement-checkbox-label input:checked + span {
            font-weight: 600;
            color: #7c3aed;
        }
        .checkbox-label { display: flex; align-items: center; gap: 8px; font-size: 0.85rem; }
        .toggle-controls { 
            display: flex; 
            gap: 15px; 
            margin-bottom: 1rem; 
            padding: 0.75rem; 
            background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
            border-radius: 8px; 
            align-items: center;
        }
        .toggle-btn {
            padding: 8px 16px;
            border: 2px solid #7c3aed;
            background: white;
            color: #7c3aed;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.85rem;
            transition: all 0.3s ease;
        }
        .toggle-btn:hover {
            background: #7c3aed;
            color: white;
        }
        .form-check-input { cursor: pointer; }
        .form-check-label { cursor: pointer; font-weight: 500; }
        .section-title {
            font-size: 1.1rem;
            font-weight: 600;
            color: #374151;
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container-fluid p-4">
    <div class="page-header">
        <div class="page-header-content">
            <div>
                <h1><i class="bi bi-plus-circle"></i> Ajouter Cotisation Syndic</h1>
                <p class="page-subtitle">Enregistrer un nouveau règlement</p>
            </div>
        </div>
    </div>

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    <div class="form-card">
        {{ form_start(form, {'attr': {'class': 'row g-3'}}) }}
        <div class="col-md-6 form-row">
            {{ form_label(form.frais, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.frais, {'attr': {'class': 'form-select'}}) }}
            {{ form_errors(form.frais) }}
        </div>
        <div class="col-md-6 form-row">
            {{ form_label(form.annee, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.annee, {'attr': {'class': 'form-select'}}) }}
            {{ form_errors(form.annee) }}
        </div>
        <div class="col-12 form-row">
            <label class="section-title">
                <i class="bi bi-building"></i> Appartements
            </label>
            <div class="toggle-controls">
                <input type="text" 
                       id="search-appartement" 
                       class="form-control" 
                       placeholder="🔍 Rechercher un appartement..."
                       style="max-width: 300px; margin-right: auto;">
                <button type="button" class="toggle-btn" id="select-all-apparts">
                    <i class="bi bi-check-all"></i> Tout sélectionner
                </button>
                <button type="button" class="toggle-btn" id="deselect-all-apparts">
                    <i class="bi bi-x-circle"></i> Tout désélectionner
                </button>
            </div>
            <div class="appartement-checkbox-group" id="appartement-list">
                <!-- Les appartements seront chargés dynamiquement via AJAX ou générés depuis le contrôleur -->
            </div>
            {{ form_widget(form.appartement, {'attr': {'style': 'display:none'}}) }}
            {{ form_errors(form.appartement) }}
        </div>
        <div class="col-12 form-row">
            {{ form_label(form.Janvier, 'Mois sélectionnés', {'label_attr': {'class': 'section-title'}}) }}
            <div class="toggle-controls">
                <button type="button" class="toggle-btn" id="select-all-months">
                    <i class="bi bi-check-all"></i> Tout sélectionner
                </button>
                <button type="button" class="toggle-btn" id="deselect-all-months">
                    <i class="bi bi-x-circle"></i> Tout désélectionner
                </button>
            </div>
            
            <div class="checkbox-group">
                <div class="checkbox-label">
                    {{ form_label(form.Janvier, 'Janvier', {'label_attr': {'class': 'form-check-label'}}) }}
                    {{ form_widget(form.Janvier, {'attr': {'class': 'form-check-input month-checkbox'}}) }}
                </div>
                <div class="checkbox-label">
                    {{ form_label(form.Fevrier, 'Février', {'label_attr': {'class': 'form-check-label'}}) }}
                    {{ form_widget(form.Fevrier, {'attr': {'class': 'form-check-input month-checkbox'}}) }}
                </div>
                <div class="checkbox-label">
                    {{ form_label(form.Mars, 'Mars', {'label_attr': {'class': 'form-check-label'}}) }}
                    {{ form_widget(form.Mars, {'attr': {'class': 'form-check-input month-checkbox'}}) }}
                </div>
                <div class="checkbox-label">
                    {{ form_label(form.Avril, 'Avril', {'label_attr': {'class': 'form-check-label'}}) }}
                    {{ form_widget(form.Avril, {'attr': {'class': 'form-check-input month-checkbox'}}) }}
                </div>
                <div class="checkbox-label">
                    {{ form_label(form.Mai, 'Mai', {'label_attr': {'class': 'form-check-label'}}) }}
                    {{ form_widget(form.Mai, {'attr': {'class': 'form-check-input month-checkbox'}}) }}
                </div>
                <div class="checkbox-label">
                    {{ form_label(form.Juin, 'Juin', {'label_attr': {'class': 'form-check-label'}}) }}
                    {{ form_widget(form.Juin, {'attr': {'class': 'form-check-input month-checkbox'}}) }}
                </div>
                <div class="checkbox-label">
                    {{ form_label(form.Juillet, 'Juillet', {'label_attr': {'class': 'form-check-label'}}) }}
                    {{ form_widget(form.Juillet, {'attr': {'class': 'form-check-input month-checkbox'}}) }}
                </div>
                <div class="checkbox-label">
                    {{ form_label(form.Aout, 'Août', {'label_attr': {'class': 'form-check-label'}}) }}
                    {{ form_widget(form.Aout, {'attr': {'class': 'form-check-input month-checkbox'}}) }}
                </div>
                <div class="checkbox-label">
                    {{ form_label(form.Septembre, 'Septembre', {'label_attr': {'class': 'form-check-label'}}) }}
                    {{ form_widget(form.Septembre, {'attr': {'class': 'form-check-input month-checkbox'}}) }}
                </div>
                <div class="checkbox-label">
                    {{ form_label(form.Octobre, 'Octobre', {'label_attr': {'class': 'form-check-label'}}) }}
                    {{ form_widget(form.Octobre, {'attr': {'class': 'form-check-input month-checkbox'}}) }}
                </div>
                <div class="checkbox-label">
                    {{ form_label(form.Novembre, 'Novembre', {'label_attr': {'class': 'form-check-label'}}) }}
                    {{ form_widget(form.Novembre, {'attr': {'class': 'form-check-input month-checkbox'}}) }}
                </div>
                <div class="checkbox-label">
                    {{ form_label(form.Decembre, 'Décembre', {'label_attr': {'class': 'form-check-label'}}) }}
                    {{ form_widget(form.Decembre, {'attr': {'class': 'form-check-input month-checkbox'}}) }}
                </div>
            </div>
            {{ form_errors(form.Janvier) }}
        </div>
        <div class="col-md-6 form-row">
            {{ form_label(form.nature_paiement, null, {'label_attr': {'class': 'form-label'}}) }}
            {{ form_widget(form.nature_paiement, {'attr': {'class': 'form-select'}}) }}
            {{ form_errors(form.nature_paiement) }}
        </div>
        <div class="col-12 form-actions">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-circle"></i> Enregistrer
            </button>
            <a href="{{ path('app_frais_syndic_reglement_index') }}" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Retour
            </a>
        </div>
        {{ form_end(form) }}
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        // Get the correct field name from the hidden select
        const hiddenSelect = $('select[name*="[appartement]"]').first();
        const fieldName = hiddenSelect.attr('name') ? hiddenSelect.attr('name').replace('[]', '') : 'frais_syndic_reglement[appartement]';
        console.log('Field name:', fieldName);

        // Load appartements on page load
        loadAppartements();

        function loadAppartements() {
            $.ajax({
                url: '/frais_syndic_reglement/get-all-appartements',
                method: 'GET',
                success: function (data) {
                    console.log('Appartements loaded:', data);
                    const appartementList = $('#appartement-list');
                    appartementList.empty();
                    
                    if (data.length > 0) {
                        data.forEach(function (appart) {
                            appartementList.append(`
                                <label class="appartement-checkbox-label" data-search="${appart.text.toLowerCase()}">
                                    <input type="checkbox" 
                                           name="${fieldName}[]" 
                                           value="${appart.id}" 
                                           class="form-check-input appartement-checkbox">
                                    <span><i class="bi bi-house-door"></i> ${appart.text}</span>
                                </label>
                            `);
                        });

                        // Sync with hidden field on change
                        syncAppartementSelection();
                    } else {
                        appartementList.append('<p class="text-muted">Aucun appartement disponible</p>');
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Error loading appartements:', status, error);
                    $('#appartement-list').html('<p class="text-danger">Erreur lors du chargement des appartements</p>');
                }
            });
        }

        // Sync checkbox selection with hidden select field
        function syncAppartementSelection() {
            $(document).on('change', '.appartement-checkbox', function () {
                const selectedIds = [];
                $('.appartement-checkbox:checked').each(function () {
                    selectedIds.push($(this).val());
                });
                hiddenSelect.val(selectedIds);
                console.log('Selected appartements:', selectedIds);
            });
        }

        // Search functionality for appartements
        $('#search-appartement').on('keyup', function () {
            const searchTerm = $(this).val().toLowerCase();
            $('.appartement-checkbox-label').each(function () {
                const text = $(this).data('search');
                if (text.includes(searchTerm)) {
                    $(this).show();
                } else {
                    $(this).hide();
                }
            });
        });

        // Select All and Deselect All for Appartements (only visible ones)
        $('#select-all-apparts').on('click', function () {
            console.log('Select All Appartements clicked');
            $('.appartement-checkbox-label:visible .appartement-checkbox').prop('checked', true).trigger('change');
        });

        $('#deselect-all-apparts').on('click', function () {
            console.log('Deselect All Appartements clicked');
            $('.appartement-checkbox-label:visible .appartement-checkbox').prop('checked', false).trigger('change');
        });

        // Select All and Deselect All for Months
        $('#select-all-months').on('click', function () {
            console.log('Select All Months clicked');
            $('.month-checkbox').prop('checked', true);
        });

        $('#deselect-all-months').on('click', function () {
            console.log('Deselect All Months clicked');
            $('.month-checkbox').prop('checked', false);
        });
    });
</script>
{% endblock %}