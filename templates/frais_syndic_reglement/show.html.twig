{% extends 'base.html.twig' %}

{% block title %}Détails du Règlement de la Cotisation Syndic #{{ frais_syndic_reglement.id }}{% endblock %}

{% block css %}
    {{ parent() }}
    {% include '_modern_show_styles.html.twig' %}
    <style>
        .month-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; padding: 1rem; background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; }
        .month-item { display: flex; align-items: center; gap: 8px; font-size: 0.9rem; }
        .month-paid { color: #10b981; font-weight: 600; }
        .month-unpaid { color: #ef4444; font-weight: 600; }
    </style>
{% endblock %}

{% block body %}
<div class="container-fluid p-4">
    <div class="page-header">
        <div class="page-header-content">
            <div>
                <h1><i class="bi bi-receipt"></i> Détails du Règlement #{{ frais_syndic_reglement.id }}</h1>
                <p class="page-subtitle">Informations complètes du règlement</p>
            </div>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="alert alert-danger">{{ message }}</div>
    {% endfor %}

    <div class="detail-card">
        <h2 class="section-title"><i class="bi bi-info-circle"></i> Informations Générales</h2>
        <table class="table-detail">
            <tr>
                <th>ID</th>
                <td>{{ frais_syndic_reglement.id }}</td>
            </tr>
            <tr>
                <th>Année</th>
                <td><span class="badge-modern bg-primary">{{ frais_syndic_reglement.annee }}</span></td>
            </tr>
            <tr>
                <th>Montant Total</th>
                <td><strong>{{ frais_syndic_reglement.totale|number_format(2) }} TND</strong></td>
            </tr>
            {% if frais_syndic_reglement.frais %}
                <tr>
                    <th>Type de Frais</th>
                    <td>{{ frais_syndic_reglement.frais.Montant|default('N/A') }}</td>
                </tr>
            {% endif %}
            {% if frais_syndic_reglement.appartement %}
                <tr>
                    <th>Appartement</th>
                    <td>{{ frais_syndic_reglement.appartement.numero|default('Appartement #' ~ frais_syndic_reglement.appartement.id) }}</td>
                </tr>
            {% endif %}
            {% if frais_syndic_reglement.personne %}
                <tr>
                    <th>Propriétaire</th>
                    <td>{{ frais_syndic_reglement.personne.nom ~ ' ' ~ frais_syndic_reglement.personne.prenom|default('N/A') }}</td>
                </tr>
            {% endif %}
            {% if frais_syndic_reglement.naturePaiement %}
                <tr>
                    <th>Nature du Paiement</th>
                    <td>{{ frais_syndic_reglement.naturePaiement|default('N/A') }}</td>
                </tr>
            {% endif %}
            {% if frais_syndic_reglement.user %}
                <tr>
                    <th>Enregistré par</th>
                    <td>{{ frais_syndic_reglement.user.email|default('N/A') }}</td>
                </tr>
            {% endif %}
        </table>
    </div>

    <div class="detail-card">
        <h2 class="section-title"><i class="bi bi-calendar-month"></i> Mois Payés</h2>
        <div class="month-grid">
                <div class="month-item {% if frais_syndic_reglement.janvier %}month-paid{% else %}month-unpaid{% endif %}">
                    <span>{{ frais_syndic_reglement.janvier ? '✅' : '❌' }}</span>
                    <span>Janvier</span>
                </div>
                <div class="month-item {% if frais_syndic_reglement.fevrier %}month-paid{% else %}month-unpaid{% endif %}">
                    <span>{{ frais_syndic_reglement.fevrier ? '✅' : '❌' }}</span>
                    <span>Février</span>
                </div>
                <div class="month-item {% if frais_syndic_reglement.mars %}month-paid{% else %}month-unpaid{% endif %}">
                    <span>{{ frais_syndic_reglement.mars ? '✅' : '❌' }}</span>
                    <span>Mars</span>
                </div>
                <div class="month-item {% if frais_syndic_reglement.avril %}month-paid{% else %}month-unpaid{% endif %}">
                    <span>{{ frais_syndic_reglement.avril ? '✅' : '❌' }}</span>
                    <span>Avril</span>
                </div>
                <div class="month-item {% if frais_syndic_reglement.mai %}month-paid{% else %}month-unpaid{% endif %}">
                    <span>{{ frais_syndic_reglement.mai ? '✅' : '❌' }}</span>
                    <span>Mai</span>
                </div>
                <div class="month-item {% if frais_syndic_reglement.juin %}month-paid{% else %}month-unpaid{% endif %}">
                    <span>{{ frais_syndic_reglement.juin ? '✅' : '❌' }}</span>
                    <span>Juin</span>
                </div>
                <div class="month-item {% if frais_syndic_reglement.juillet %}month-paid{% else %}month-unpaid{% endif %}">
                    <span>{{ frais_syndic_reglement.juillet ? '✅' : '❌' }}</span>
                    <span>Juillet</span>
                </div>
                <div class="month-item {% if frais_syndic_reglement.aout %}month-paid{% else %}month-unpaid{% endif %}">
                    <span>{{ frais_syndic_reglement.aout ? '✅' : '❌' }}</span>
                    <span>Août</span>
                </div>
                <div class="month-item {% if frais_syndic_reglement.septembre %}month-paid{% else %}month-unpaid{% endif %}">
                    <span>{{ frais_syndic_reglement.septembre ? '✅' : '❌' }}</span>
                    <span>Septembre</span>
                </div>
                <div class="month-item {% if frais_syndic_reglement.octobre %}month-paid{% else %}month-unpaid{% endif %}">
                    <span>{{ frais_syndic_reglement.octobre ? '✅' : '❌' }}</span>
                    <span>Octobre</span>
                </div>
                <div class="month-item {% if frais_syndic_reglement.novembre %}month-paid{% else %}month-unpaid{% endif %}">
                    <span>{{ frais_syndic_reglement.novembre ? '✅' : '❌' }}</span>
                    <span>Novembre</span>
                </div>
                <div class="month-item {% if frais_syndic_reglement.decembre %}month-paid{% else %}month-unpaid{% endif %}">
                    <span>{{ frais_syndic_reglement.decembre ? '✅' : '❌' }}</span>
                    <span>Décembre</span>
                </div>
            </div>
        </div>
    </div>

    <div class="action-buttons">
        <a href="{{ path('app_frais_syndic_reglement_index') }}" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
        <a href="{{ path('app_frais_syndic_reglement_edit', {'id': frais_syndic_reglement.id}) }}" class="btn btn-warning">
            <i class="bi bi-pencil-fill"></i> Modifier
        </a>
        {{ include('frais_syndic_reglement/_delete_form.html.twig') }}
    </div>
</div>
{% endblock %}
