{% extends 'base.html.twig' %}

{% block title %}Détails du Document{% endblock %}

{% block css %}
    {{ parent() }}
    {% include '_modern_show_styles.html.twig' %}
{% endblock %}

{% block body %}
<div class="container-fluid p-4">
    <div class="page-header">
        <div class="page-header-content">
            <div>
                <h1><i class="bi bi-file-earmark-text"></i> Détails Document #{{ papier.id }}</h1>
                <p class="page-subtitle">Informations du document</p>
            </div>
        </div>
    </div>

    <div class="detail-card">
        <h2 class="section-title"><i class="bi bi-info-circle"></i> Informations</h2>
        <div class="info-grid">
            <div class="info-item">
                <label>ID</label>
                <div class="info-value">{{ papier.id }}</div>
            </div>
            <div class="info-item">
                <label>Type</label>
                <div class="info-value">{{ papier.typePapier ? papier.typePapier.libelle : '—' }}</div>
            </div>
            <div class="info-item">
                <label>Date de création</label>
                <div class="info-value">{{ papier.dateCreation ? papier.dateCreation|date('d/m/Y') : '' }}</div>
            </div>
            <div class="info-item full-width">
                <label>Description</label>
                <div class="info-value">{{ papier.Description }}</div>
            </div>
            <div class="info-item full-width">
                <label>Document</label>
                <div class="info-value">
                    {% if papier.AttachedFile %}
                        {% if papier.AttachedFile ends with '.pdf' %}
                            <div class="alert alert-info">
                                <i class="bi bi-file-earmark-pdf-fill text-danger"></i>
                                <a href="{{ asset('uploads/papiers/' ~ papier.AttachedFile) }}" 
                                   target="_blank" 
                                   class="btn btn-sm btn-outline-primary ms-2">
                                    Voir le PDF
                                </a>
                            </div>
                        {% else %}
                            <div class="text-center">
                                <img src="{{ asset('uploads/papiers/' ~ papier.AttachedFile) }}" 
                                     class="img-thumbnail" 
                                     style="max-height: 300px;"
                                     alt="Document joint">
                                <div class="mt-2">
                                    <a href="{{ asset('uploads/papiers/' ~ papier.AttachedFile) }}" 
                                       download 
                                       class="btn btn-sm btn-outline-success">
                                        <i class="bi bi-download"></i> Télécharger
                                    </a>
                                </div>
                            </div>
                        {% endif %}
                    {% else %}
                        <div class="alert alert-warning">Aucun document joint</div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="action-buttons">
        <a href="{{ path('app_papier_index') }}" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
        <a href="{{ path('app_papier_edit', {'id': papier.id}) }}" class="btn btn-warning">
            <i class="bi bi-pencil-fill"></i> Modifier
        </a>
        {{ include('papier/_delete_form.html.twig') }}
    </div>
</div>
{% endblock %}