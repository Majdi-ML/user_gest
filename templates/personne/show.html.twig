{% extends 'base.html.twig' %}

{% block title %}Détails de {{ personne.nom }}{% endblock %}

{% block css %}
    {{ parent() }}
    {% include '_modern_show_styles.html.twig' %}
{% endblock %}

{% block body %}
<div class="container-fluid mt-4 px-4 fade-in">
    <div class="page-header">
        <h1>
            <span class="page-header-icon">👤</span>
            Détails de {{ personne.nom }} {{ personne.prenom }}
        </h1>
        <p class="mb-0 mt-2" style="opacity: 0.9;">Informations détaillées de la personne</p>
    </div>

    <div class="detail-card">
        <div class="card-header">
            <i class="bi bi-person-circle"></i> Informations Personnelles
        </div>
        <div class="card-body">
            <div class="info-grid">
                <div class="info-item">
                    <label><i class="bi bi-person-fill"></i> Nom</label>
                    <div class="info-value">{{ personne.nom }}</div>
                </div>
                <div class="info-item">
                    <label><i class="bi bi-person-badge-fill"></i> Prénom</label>
                    <div class="info-value">{{ personne.prenom }}</div>
                </div>
                <div class="info-item">
                    <label><i class="bi bi-envelope-fill"></i> Email</label>
                    <div class="info-value">{{ personne.email }}</div>
                </div>
                <div class="info-item">
                    <label><i class="bi bi-telephone-fill"></i> Téléphone</label>
                    <div class="info-value">{{ personne.telephone }}</div>
                </div>
                <div class="info-item full-width">
                    <label><i class="bi bi-house-fill"></i> Adresse</label>
                    <div class="info-value">{{ personne.adresse }}</div>
                </div>
                <div class="info-item">
                    <label><i class="bi bi-tag-fill"></i> Statut</label>
                    <div class="info-value">
                        <span class="badge badge-modern {% if personne.status == 'proprietaire' %}bg-primary{% else %}bg-info{% endif %}">
                            {{ personne.status|upper }}
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <h2 class="mb-3">💰 Frais Syndic Règlement</h2>

    {% if personne.status == 'proprietaire' %}
        {% if personne.fraisSyndicReglements is not empty %}
            {# Collect unique valid years #}
            {% set validYears = [] %}
            {% for frais in personne.fraisSyndicReglements %}
                {% set anneeVal = frais.annee|default(0) %}
                {% if anneeVal >= 2000 and anneeVal <= 2100 and anneeVal not in validYears %}
                    {% set validYears = validYears|merge([anneeVal]) %}
                {% endif %}
            {% endfor %}

            {% set validYears = validYears|sort|reverse %}

            {% if validYears is not empty %}
                {% for displayYear in validYears %}
                    <div class="detail-card">
                        <div class="card-header">
                            <i class="bi bi-calendar-check-fill"></i> Année {{ displayYear }}
                        </div>
                        <div class="card-body">
                            <div class="table-wrapper">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>Montant</th>
                                            <th>Mois</th>
                                            <th>Appartement</th>
                                        </tr>
                                    </thead>
                            <tbody>
                                {% for frais in personne.fraisSyndicReglements %}
                                    {% if frais.annee == displayYear %}
                                    <tr>
                                        <td>{{ frais.totale|default(0) }} TND</td>
                                        <td>
                                            {% set months = [] %}
                                            {% if frais.Janvier %} {% set months = months|merge(['Janvier']) %} {% endif %}
                                            {% if frais.fevrier %} {% set months = months|merge(['Février']) %} {% endif %}
                                            {% if frais.mars %} {% set months = months|merge(['Mars']) %} {% endif %}
                                            {% if frais.avril %} {% set months = months|merge(['Avril']) %} {% endif %}
                                            {% if frais.mai %} {% set months = months|merge(['Mai']) %} {% endif %}
                                            {% if frais.juin %} {% set months = months|merge(['Juin']) %} {% endif %}
                                            {% if frais.juillet %} {% set months = months|merge(['Juillet']) %} {% endif %}
                                            {% if frais.aout %} {% set months = months|merge(['Août']) %} {% endif %}
                                            {% if frais.septembre %} {% set months = months|merge(['Septembre']) %} {% endif %}
                                            {% if frais.octobre %} {% set months = months|merge(['Octobre']) %} {% endif %}
                                            {% if frais.novembre %} {% set months = months|merge(['Novembre']) %} {% endif %}
                                            {% if frais.decembre %} {% set months = months|merge(['Décembre']) %} {% endif %}
                                            {{ months is not empty ? months|join(', ') : '—' }}
                                        </td>
                                        <td>{{ frais.appartement.numero|default('—') }}</td>
                                    </tr>
                                    {% endif %}
                                {% endfor %}
                            </tbody>
                        </table>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            {% else %}
                <div class="alert alert-warning"><i class="bi bi-exclamation-triangle-fill"></i> Aucun frais syndic règlement avec une année valide enregistré pour cette personne.</div>
            {% endif %}
        {% else %}
            <div class="alert alert-warning"><i class="bi bi-exclamation-triangle-fill"></i> Aucun frais syndic règlement enregistré pour cette personne.</div>
        {% endif %}
    {% else %}
        <div class="alert alert-info"><i class="bi bi-info-circle-fill"></i> Cette personne n'est pas propriétaire, aucun frais syndic règlement à afficher.</div>
    {% endif %}

    <div class="action-buttons">
        <a href="{{ path('app_personne_index') }}" class="btn btn-secondary">
            <i class="bi bi-arrow-left-circle-fill"></i> Retour à la liste
        </a>
        <a href="{{ path('app_personne_edit', {'id': personne.id}) }}" class="btn btn-warning">
            <i class="bi bi-pencil-fill"></i> Modifier
        </a>
        {{ include('personne/_delete_form.html.twig') }}
    </div>
</div>
{% endblock %}