{% extends 'base.html.twig' %}

{% block title %}Détails du Rassemblement{% endblock %}

{% block css %}
    {{ parent() }}
    {% include '_modern_show_styles.html.twig' %}
{% endblock %}

{% block body %}
<div class="container-fluid p-4">
    <div class="page-header">
        <div class="page-header-content">
            <div>
                <h1><i class="bi bi-calendar-event"></i> Détails Rassemblement #{{ rassemeblement.id }}</h1>
                <p class="page-subtitle">Informations de la réunion</p>
            </div>
        </div>
    </div>

    <div class="detail-card">
        <h2 class="section-title"><i class="bi bi-info-circle"></i> Informations</h2>
        <div class="info-grid">
            <div class="info-item">
                <label>ID</label>
                <div class="info-value">{{ rassemeblement.id }}</div>
            </div>
            <div class="info-item">
                <label>Type</label>
                <div class="info-value">{{ rassemeblement.Type ? rassemeblement.Type.libelle : '—' }}</div>
            </div>
            <div class="info-item">
                <label>Date</label>
                <div class="info-value">{{ rassemeblement.date ? rassemeblement.date|date('d/m/Y') : '' }}</div>
            </div>
            <div class="info-item full-width">
                <label>PV</label>
                <div class="info-value">
                    {% if rassemeblement.Pv %}
                        {% if rassemeblement.Pv ends with '.pdf' %}
                            <div class="alert alert-info">
                                <i class="bi bi-file-earmark-pdf-fill text-danger"></i>
                                <a href="{{ asset('uploads/rassemblements/' ~ rassemeblement.Pv) }}" 
                                   target="_blank" 
                                   class="btn btn-sm btn-outline-primary ms-2">
                                    Voir le PV (PDF)
                                </a>
                            </div>
                        {% else %}
                            <div class="text-center">
                                <img src="{{ asset('uploads/rassemblements/' ~ rassemeblement.Pv) }}" 
                                     class="img-thumbnail" 
                                     style="max-height: 300px;"
                                     alt="PV du rassemblement">
                                <div class="mt-2">
                                    <a href="{{ asset('uploads/rassemblements/' ~ rassemeblement.Pv) }}" 
                                       download 
                                       class="btn btn-sm btn-outline-success">
                                        <i class="bi bi-download"></i> Télécharger
                                    </a>
                                </div>
                            </div>
                        {% endif %}
                    {% else %}
                        <div class="alert alert-warning">Aucun PV joint</div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <div class="action-buttons">
        <a href="{{ path('app_rassemeblement_index') }}" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Retour
        </a>
        <a href="{{ path('app_rassemeblement_edit', {'id': rassemeblement.id}) }}" class="btn btn-warning">
            <i class="bi bi-pencil-fill"></i> Modifier
        </a>
        {{ include('rassemeblement/_delete_form.html.twig') }}
    </div>
</div>
{% endblock %}