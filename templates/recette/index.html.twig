{% extends 'base.html.twig' %}

{% block title %}Liste des Recettes{% endblock %}

{% block css %}
    {{ parent() }}
    {% include '_modern_index_styles.html.twig' %}
{% endblock %}

{% block body %}
<div class="container-fluid mt-4 px-4 fade-in">
    <div class="page-header">
        <h1>
            <span class="page-header-icon">💰</span>
            Liste des Recettes
        </h1>
        <p class="mb-0 mt-2" style="opacity: 0.9;">Gestion des recettes et revenus</p>
    </div>

    <div class="action-bar" style="display: flex; justify-content: flex-end; align-items: center;">
        <a href="{{ path('app_recette_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-circle-fill"></i> Nouvelle Recette
        </a>
    </div>

    <ul class="nav nav-tabs person-type-tabs" id="yearTabs" role="tablist">
        {% for year, yearRecettes in recettesByYear %}
            <li class="nav-item" role="presentation">
                <button class="nav-link {% if loop.first %}active{% endif %}" 
                        id="year-{{ year }}-tab" 
                        data-bs-toggle="tab" 
                        data-bs-target="#year-{{ year }}" 
                        type="button" 
                        role="tab" 
                        aria-controls="year-{{ year }}" 
                        aria-selected="{{ loop.first ? 'true' : 'false' }}">
                    <i class="bi bi-calendar-fill"></i> {{ year }}
                </button>
            </li>
        {% endfor %}
    </ul>

    <div class="tab-content" id="yearTabContent">
        {% for year, yearRecettes in recettesByYear %}
            <div class="tab-pane fade {% if loop.first %}show active{% endif %}" 
                 id="year-{{ year }}" 
                 role="tabpanel" 
                 aria-labelledby="year-{{ year }}-tab">
                <div class="d-flex justify-content-end gap-2 mb-2">
                    <button class="btn btn-danger btn-sm btn-export-pdf" data-target="recettesTable-{{ year }}" data-title="Récapitulatif Recettes {{ year }}">
                        <i class="bi bi-file-earmark-pdf-fill"></i> PDF
                    </button>
                    <button class="btn btn-success btn-sm btn-export-excel" data-target="recettesTable-{{ year }}" data-title="Recap_Recettes_{{ year }}">
                        <i class="bi bi-file-earmark-excel-fill"></i> Excel
                    </button>
                </div>
                <div class="table-card">
                    <div class="table-responsive">
                        <table class="table table-modern" id="recettesTable-{{ year }}">
                            <thead>
                                <tr>
                                    <th><i class="bi bi-calendar3"></i> Mois</th>
                                    <th colspan="2"><i class="bi bi-building"></i> Cotisation Syndic</th>
                                    <th colspan="2"><i class="bi bi-cash-stack"></i> Autre revenu</th>
                                    <th><i class="bi bi-calculator"></i> Total</th>
                                </tr>
                                <tr>
                                    <th></th>
                                    <th>Espèce</th>
                                    <th>Bancaire</th>
                                    <th>Espèce</th>
                                    <th>Bancaire</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% set moisOrdre = ['January','February','March','April','May','June','July','August','September','October','November','December'] %}
                                {% set moisNoms = {
                                    'January': 'Janvier',
                                    'February': 'Février',
                                    'March': 'Mars',
                                    'April': 'Avril',
                                    'May': 'Mai',
                                    'June': 'Juin',
                                    'July': 'Juillet',
                                    'August': 'Août',
                                    'September': 'Septembre',
                                    'October': 'Octobre',
                                    'November': 'Novembre',
                                    'December': 'Décembre'
                                } %}
                                
                                {% for month in moisOrdre %}
                                    {% if yearRecettes[month] is defined %}
                                        <tr>
                                            <td><strong>{{ moisNoms[month] }}</strong></td>
                                            <td>{{ yearRecettes[month]['Cotisation Syndic']['Espece']|number_format(2, '.', ' ') }} DT</td>
                                            <td>{{ yearRecettes[month]['Cotisation Syndic']['Bancaire']|number_format(2, '.', ' ') }} DT</td>
                                            <td>{{ yearRecettes[month]['Autre revenu']['Espece']|number_format(2, '.', ' ') }} DT</td>
                                            <td>{{ yearRecettes[month]['Autre revenu']['Bancaire']|number_format(2, '.', ' ') }} DT</td>
                                            <td><strong>
                                                {% set total = yearRecettes[month]['Cotisation Syndic']['Espece'] + 
                                                               yearRecettes[month]['Cotisation Syndic']['Bancaire'] + 
                                                               yearRecettes[month]['Autre revenu']['Espece'] + 
                                                               yearRecettes[month]['Autre revenu']['Bancaire'] %}
                                                {{ total|number_format(2, '.', ' ') }} DT
                                            </strong></td>
                                        </tr>
                                    {% endif %}
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                <h3 class="mt-4 mb-3"><i class="bi bi-list-ul"></i> Détails des recettes {{ year }}</h3>
                <div class="d-flex justify-content-end gap-2 mb-2">
                    <button class="btn btn-danger btn-sm btn-export-pdf" data-target="detailTable-{{ year }}" data-title="Détails Recettes {{ year }}">
                        <i class="bi bi-file-earmark-pdf-fill"></i> PDF
                    </button>
                    <button class="btn btn-success btn-sm btn-export-excel" data-target="detailTable-{{ year }}" data-title="Details_Recettes_{{ year }}">
                        <i class="bi bi-file-earmark-excel-fill"></i> Excel
                    </button>
                </div>
                <div class="table-card">
                    <div class="table-responsive">
                        <table class="table table-modern" id="detailTable-{{ year }}">
                            <thead>
                                <tr>
                                    <th><i class="bi bi-hash"></i> ID</th>
                                    <th><i class="bi bi-cash"></i> Montant</th>
                                    <th><i class="bi bi-calendar-event"></i> Date</th>
                                    <th><i class="bi bi-tag"></i> Type</th>
                                    <th><i class="bi bi-wallet2"></i> Nature</th>
                                    <th><i class="bi bi-file-text"></i> Description</th>
                                    <th><i class="bi bi-gear-fill"></i> Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for recette in recettes %}
                                    {% if recette.dateRecette|date('Y') == year %}
                                        <tr>
                                            <td><span class="badge-modern bg-light">{{ recette.id }}</span></td>
                                            <td><span class="badge-modern bg-success">{{ recette.montant|number_format(2, '.', ' ') }} DT</span></td>
                                            <td>{{ recette.dateRecette|date('d/m/Y') }}</td>
                                            <td>{{ recette.typeRecette }}</td>
                                            <td>
                                                <span class="badge-modern {% if recette.natureRecette == 'Bancaire' %}bg-primary{% else %}bg-warning{% endif %}">
                                                    {{ recette.natureRecette }}
                                                </span>
                                            </td>
                                            <td>{{ recette.description|slice(0, 50) }}{% if recette.description|length > 50 %}...{% endif %}</td>
                                            <td>
                                                <div class="action-buttons">
                                                    <a href="{{ path('app_recette_show', {'id': recette.id}) }}" class="btn btn-sm btn-info" title="Voir">
                                                        <i class="bi bi-eye-fill"></i>
                                                    </a>
                                                    <a href="{{ path('app_recette_edit', {'id': recette.id}) }}" class="btn btn-sm btn-warning" title="Modifier">
                                                        <i class="bi bi-pencil-fill"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    {% endif %}
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}

{% block js %}
    {{ parent() }}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script>
        $(document).ready(function() {

            // ========== GENERIC: Collect table data ==========
            function collectTableData(tableId) {
                const table = document.getElementById(tableId);
                if (!table) return { headers: [], data: [] };

                const headers = [];
                const headerRow = table.querySelector('thead tr:last-child') || table.querySelector('thead tr');
                if (headerRow) {
                    headerRow.querySelectorAll('th').forEach(th => {
                        headers.push(th.textContent.trim());
                    });
                }

                // If we got empty headers from a sub-row, use first row
                if (headers.every(h => h === '')) {
                    headers.length = 0;
                    const firstRow = table.querySelector('thead tr:first-child');
                    if (firstRow) {
                        firstRow.querySelectorAll('th').forEach(th => {
                            const colspan = parseInt(th.getAttribute('colspan')) || 1;
                            const text = th.textContent.trim();
                            for (let i = 0; i < colspan; i++) {
                                headers.push(text + (colspan > 1 ? ` (${i+1})` : ''));
                            }
                        });
                    }
                }

                const data = [];
                table.querySelectorAll('tbody tr').forEach(tr => {
                    const row = [];
                    tr.querySelectorAll('td').forEach(td => {
                        row.push(td.textContent.trim());
                    });
                    if (row.length > 0) data.push(row);
                });

                return { headers, data };
            }

            // ========== PDF Export ==========
            $(document).on('click', '.btn-export-pdf', function() {
                const tableId = $(this).data('target');
                const title = $(this).data('title') || 'Export';
                const { headers, data } = collectTableData(tableId);

                if (data.length === 0) {
                    alert('Aucune donnée à exporter.');
                    return;
                }

                const { jsPDF } = window.jspdf;
                const doc = new jsPDF({ orientation: 'landscape' });

                doc.setFontSize(16);
                doc.text(title, 14, 15);

                // For recap tables with merged header, build proper headers
                let headRows;
                if (tableId.startsWith('recettesTable-')) {
                    headRows = [
                        [{ content: 'Mois', rowSpan: 2 }, { content: 'Cotisation Syndic', colSpan: 2 }, { content: 'Autre revenu', colSpan: 2 }, { content: 'Total', rowSpan: 2 }],
                        ['Espèce', 'Bancaire', 'Espèce', 'Bancaire']
                    ];
                } else {
                    headRows = [headers];
                }

                doc.autoTable({
                    head: headRows,
                    body: data,
                    startY: 25,
                    theme: 'striped',
                    headStyles: { fillColor: [124, 58, 237], fontSize: 9 },
                    styles: { fontSize: 8 },
                    didParseCell: function(hookData) {
                        // Bold the last column (Total / Actions removed)
                        if (hookData.section === 'body') {
                            const lastCol = hookData.row.cells.length - 1;
                            if (hookData.column.index === lastCol) {
                                hookData.cell.styles.fontStyle = 'bold';
                            }
                        }
                    }
                });

                doc.save(title.replace(/\s+/g, '_') + '.pdf');
            });

            // ========== Excel Export ==========
            $(document).on('click', '.btn-export-excel', function() {
                const tableId = $(this).data('target');
                const title = $(this).data('title') || 'Export';
                const { headers, data } = collectTableData(tableId);

                if (data.length === 0) {
                    alert('Aucune donnée à exporter.');
                    return;
                }

                // For recap tables, use descriptive headers
                let excelHeaders;
                if (tableId.startsWith('recettesTable-')) {
                    excelHeaders = ['Mois', 'Cotisation Espèce', 'Cotisation Bancaire', 'Autre Espèce', 'Autre Bancaire', 'Total'];
                } else if (tableId.startsWith('detailTable-')) {
                    excelHeaders = ['ID', 'Montant', 'Date', 'Type', 'Nature', 'Description'];
                } else {
                    excelHeaders = headers;
                }

                const sheetData = [excelHeaders, ...data];
                const wb = XLSX.utils.book_new();
                const ws = XLSX.utils.aoa_to_sheet(sheetData);

                // Auto-size columns
                ws['!cols'] = excelHeaders.map((h, i) => ({
                    wch: Math.max(h.length, ...data.map(r => (r[i] || '').length)) + 2
                }));

                XLSX.utils.book_append_sheet(wb, ws, title.substring(0, 31));
                XLSX.writeFile(wb, title.replace(/\s+/g, '_') + '.xlsx');
            });

        });
    </script>
{% endblock %}