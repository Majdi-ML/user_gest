{% extends 'base.html.twig' %}

{% block title %}Liste des Recettes{% endblock %}

{% block css %}
    {{ parent() }}
    {% include '_modern_index_styles.html.twig' %}
{% endblock %}

{% block body %}
<div class="container-fluid mt-4 px-4 fade-in">
    <div class="page-header">
        <h1>
            <span class="page-header-icon">💰</span>
            Liste des Recettes
        </h1>
        <p class="mb-0 mt-2" style="opacity: 0.9;">Gestion des recettes et revenus</p>
    </div>

    <div class="action-bar" style="display: flex; justify-content: space-between; align-items: center;">
        <div class="d-flex gap-2">
            <button id="exportPdfBtn" class="btn btn-danger btn-sm">
                <i class="bi bi-file-earmark-pdf-fill"></i> Exporter PDF
            </button>
            <button id="exportExcelBtn" class="btn btn-success btn-sm">
                <i class="bi bi-file-earmark-excel-fill"></i> Exporter Excel
            </button>
        </div>
        <a href="{{ path('app_recette_new') }}" class="btn btn-primary">
            <i class="bi bi-plus-circle-fill"></i> Nouvelle Recette
        </a>
    </div>

    <ul class="nav nav-tabs person-type-tabs" id="yearTabs" role="tablist">
        {% for year, yearRecettes in recettesByYear %}
            <li class="nav-item" role="presentation">
                <button class="nav-link {% if loop.first %}active{% endif %}" 
                        id="year-{{ year }}-tab" 
                        data-bs-toggle="tab" 
                        data-bs-target="#year-{{ year }}" 
                        type="button" 
                        role="tab" 
                        aria-controls="year-{{ year }}" 
                        aria-selected="{{ loop.first ? 'true' : 'false' }}">
                    <i class="bi bi-calendar-fill"></i> {{ year }}
                </button>
            </li>
        {% endfor %}
    </ul>

    <div class="tab-content" id="yearTabContent">
        {% for year, yearRecettes in recettesByYear %}
            <div class="tab-pane fade {% if loop.first %}show active{% endif %}" 
                 id="year-{{ year }}" 
                 role="tabpanel" 
                 aria-labelledby="year-{{ year }}-tab">
                <div class="table-card">
                    <div class="table-responsive">
                        <table class="table table-modern" id="recettesTable-{{ year }}">
                            <thead>
                                <tr>
                                    <th><i class="bi bi-calendar3"></i> Mois</th>
                                    <th colspan="2"><i class="bi bi-building"></i> Cotisation Syndic</th>
                                    <th colspan="2"><i class="bi bi-cash-stack"></i> Autre revenu</th>
                                    <th><i class="bi bi-calculator"></i> Total</th>
                                </tr>
                                <tr>
                                    <th></th>
                                    <th>Espèce</th>
                                    <th>Bancaire</th>
                                    <th>Espèce</th>
                                    <th>Bancaire</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% set moisOrdre = ['January','February','March','April','May','June','July','August','September','October','November','December'] %}
                                {% set moisNoms = {
                                    'January': 'Janvier',
                                    'February': 'Février',
                                    'March': 'Mars',
                                    'April': 'Avril',
                                    'May': 'Mai',
                                    'June': 'Juin',
                                    'July': 'Juillet',
                                    'August': 'Août',
                                    'September': 'Septembre',
                                    'October': 'Octobre',
                                    'November': 'Novembre',
                                    'December': 'Décembre'
                                } %}
                                
                                {% for month in moisOrdre %}
                                    {% if yearRecettes[month] is defined %}
                                        <tr>
                                            <td><strong>{{ moisNoms[month] }}</strong></td>
                                            <td>{{ yearRecettes[month]['Cotisation Syndic']['Espece']|number_format(2, '.', ' ') }} DT</td>
                                            <td>{{ yearRecettes[month]['Cotisation Syndic']['Bancaire']|number_format(2, '.', ' ') }} DT</td>
                                            <td>{{ yearRecettes[month]['Autre revenu']['Espece']|number_format(2, '.', ' ') }} DT</td>
                                            <td>{{ yearRecettes[month]['Autre revenu']['Bancaire']|number_format(2, '.', ' ') }} DT</td>
                                            <td><strong>
                                                {% set total = yearRecettes[month]['Cotisation Syndic']['Espece'] + 
                                                               yearRecettes[month]['Cotisation Syndic']['Bancaire'] + 
                                                               yearRecettes[month]['Autre revenu']['Espece'] + 
                                                               yearRecettes[month]['Autre revenu']['Bancaire'] %}
                                                {{ total|number_format(2, '.', ' ') }} DT
                                            </strong></td>
                                        </tr>
                                    {% endif %}
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                <h3 class="mt-4 mb-3"><i class="bi bi-list-ul"></i> Détails des recettes {{ year }}</h3>
                <div class="table-card">
                    <div class="table-responsive">
                        <table class="table table-modern">
                            <thead>
                                <tr>
                                    <th><i class="bi bi-hash"></i> ID</th>
                                    <th><i class="bi bi-cash"></i> Montant</th>
                                    <th><i class="bi bi-calendar-event"></i> Date</th>
                                    <th><i class="bi bi-tag"></i> Type</th>
                                    <th><i class="bi bi-wallet2"></i> Nature</th>
                                    <th><i class="bi bi-file-text"></i> Description</th>
                                    <th><i class="bi bi-gear-fill"></i> Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for recette in recettes %}
                                    {% if recette.dateRecette|date('Y') == year %}
                                        <tr>
                                            <td><span class="badge-modern bg-light">{{ recette.id }}</span></td>
                                            <td><span class="badge-modern bg-success">{{ recette.montant|number_format(2, '.', ' ') }} DT</span></td>
                                            <td>{{ recette.dateRecette|date('d/m/Y') }}</td>
                                            <td>{{ recette.typeRecette }}</td>
                                            <td>
                                                <span class="badge-modern {% if recette.natureRecette == 'Bancaire' %}bg-primary{% else %}bg-warning{% endif %}">
                                                    {{ recette.natureRecette }}
                                                </span>
                                            </td>
                                            <td>{{ recette.description|slice(0, 50) }}{% if recette.description|length > 50 %}...{% endif %}</td>
                                            <td>
                                                <div class="action-buttons">
                                                    <a href="{{ path('app_recette_show', {'id': recette.id}) }}" class="btn btn-sm btn-info" title="Voir">
                                                        <i class="bi bi-eye-fill"></i>
                                                    </a>
                                                    <a href="{{ path('app_recette_edit', {'id': recette.id}) }}" class="btn btn-sm btn-warning" title="Modifier">
                                                        <i class="bi bi-pencil-fill"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    {% endif %}
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.31/jspdf.plugin.autotable.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    <script>
        $(document).ready(function() {
            function getActiveYear() {
                return $('#yearTabs .nav-link.active').text().trim();
            }

            function collectSummaryData() {
                const year = getActiveYear();
                const table = $(`#year-${year} table.table-modern`).first();
                const headers = ['Mois', 'Cotisation Espèce', 'Cotisation Bancaire', 'Autre Espèce', 'Autre Bancaire', 'Total'];
                const data = [];

                table.find('tbody tr').each(function() {
                    const cells = $(this).find('td');
                    if (cells.length >= 6) {
                        data.push({
                            'Mois': cells.eq(0).text().trim(),
                            'Cotisation Espèce': cells.eq(1).text().trim(),
                            'Cotisation Bancaire': cells.eq(2).text().trim(),
                            'Autre Espèce': cells.eq(3).text().trim(),
                            'Autre Bancaire': cells.eq(4).text().trim(),
                            'Total': cells.eq(5).text().trim()
                        });
                    }
                });

                return { year, headers, data };
            }

            function collectDetailData() {
                const year = getActiveYear();
                const tables = $(`#year-${year} table.table-modern`);
                const detailTable = tables.length > 1 ? tables.eq(1) : null;
                const headers = ['ID', 'Montant', 'Date', 'Type', 'Nature', 'Description'];
                const data = [];

                if (detailTable) {
                    detailTable.find('tbody tr').each(function() {
                        const cells = $(this).find('td');
                        if (cells.length >= 6) {
                            data.push({
                                'ID': cells.eq(0).text().trim(),
                                'Montant': cells.eq(1).text().trim(),
                                'Date': cells.eq(2).text().trim(),
                                'Type': cells.eq(3).text().trim(),
                                'Nature': cells.eq(4).text().trim(),
                                'Description': cells.eq(5).text().trim()
                            });
                        }
                    });
                }

                return { year, headers, data };
            }

            $('#exportPdfBtn').click(function() {
                const { jsPDF } = window.jspdf;
                const doc = new jsPDF({ orientation: 'landscape' });
                
                const summary = collectSummaryData();
                const detail = collectDetailData();

                doc.setFontSize(16);
                doc.text(`Recettes - Année ${summary.year}`, 14, 15);

                doc.setFontSize(12);
                doc.text('Récapitulatif mensuel', 14, 25);
                doc.autoTable({
                    head: [summary.headers],
                    body: summary.data.map(row => summary.headers.map(h => row[h])),
                    startY: 30,
                    theme: 'striped',
                    headStyles: { fillColor: [102, 126, 234] },
                    styles: { fontSize: 9 }
                });

                if (detail.data.length > 0) {
                    const finalY = doc.lastAutoTable.finalY + 10;
                    doc.setFontSize(12);
                    doc.text(`Détails des recettes ${detail.year}`, 14, finalY);
                    doc.autoTable({
                        head: [detail.headers],
                        body: detail.data.map(row => detail.headers.map(h => row[h])),
                        startY: finalY + 5,
                        theme: 'striped',
                        headStyles: { fillColor: [40, 167, 69] },
                        styles: { fontSize: 9 }
                    });
                }

                doc.save(`recettes_${summary.year}.pdf`);
            });

            $('#exportExcelBtn').click(function() {
                const summary = collectSummaryData();
                const detail = collectDetailData();

                const wb = XLSX.utils.book_new();

                const wsSummary = XLSX.utils.json_to_sheet(summary.data, { header: summary.headers });
                XLSX.utils.book_append_sheet(wb, wsSummary, `Recap ${summary.year}`);

                if (detail.data.length > 0) {
                    const wsDetail = XLSX.utils.json_to_sheet(detail.data, { header: detail.headers });
                    XLSX.utils.book_append_sheet(wb, wsDetail, `Details ${detail.year}`);
                }

                XLSX.writeFile(wb, `recettes_${summary.year}.xlsx`);
            });
        });
    </script>
{% endblock %}