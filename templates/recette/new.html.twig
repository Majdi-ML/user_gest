{% extends 'base.html.twig' %}

{% block title %}Nouvelle Recette{% endblock %}

{% block css %}
    {{ parent() }}
    {% include '_modern_form_styles.html.twig' %}
{% endblock %}

{% block body %}
<div class="container-fluid mt-4 px-4 fade-in">
    <div class="page-header">
        <h1>
            <span class="page-header-icon">💰</span>
            Ajouter une nouvelle recette
        </h1>
        <p class="mb-0 mt-2" style="opacity: 0.9;">Enregistrez un nouveau revenu</p>
    </div>

    <div class="form-card">
        <div class="card-header">
            <i class="bi bi-plus-circle-fill"></i> Formulaire d'ajout
        </div>
        <div class="card-body">
            {{ include('recette/_form.html.twig') }}
        </div>
    </div>

    <div class="action-buttons">
        <a href="{{ path('app_recette_index') }}" class="btn btn-secondary">
            <i class="bi bi-arrow-left-circle-fill"></i> Retour à la liste
        </a>
    </div>
</div>
{% endblock %}
